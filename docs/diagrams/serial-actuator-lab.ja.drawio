xGeometry x="45" y="626" width="300" height="24" as="geometry"/></mxCell><mxCell id="p625810-65" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E88E5;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="665" as="sourcePoint"/><mxPoint x="110" y="665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p625810-66" value="USB（双方向）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="653" width="250" height="24" as="geometry"/></mxCell><mxCell id="p625810-67" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E67E00;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="707" as="sourcePoint"/><mxPoint x="110" y="707" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p625810-68" value="TX: MCU → モータ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="695" width="250" height="24" as="geometry"/></mxCell><mxCell id="p625810-69" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="749" as="sourcePoint"/><mxPoint x="110" y="749" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p625810-70" value="RX: モータ → MCU" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="737" width="250" height="24" as="geometry"/></mxCell><mxCell id="p625810-71" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="791" as="sourcePoint"/><mxPoint x="110" y="791" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p625810-72" value="DIR: 方向制御" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="779" width="250" height="24" as="geometry"/></mxCell><mxCell id="p625810-73" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#0097B8;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="665" as="sourcePoint"/><mxPoint x="450" y="665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p625810-74" value="DATA: 半二重の単線" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="653" width="250" height="24" as="geometry"/></mxCell><mxCell id="p625810-75" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3D85C6;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="707" as="sourcePoint"/><mxPoint x="450" y="707" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p625810-76" value="3.3V ロジック電源" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="695" width="250" height="24" as="geometry"/></mxCell><mxCell id="p625810-77" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D32F2F;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="749" as="sourcePoint"/><mxPoint x="450" y="749" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p625810-78" value="5V モータ電源" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="737" width="250" height="24" as="geometry"/></mxCell><mxCell id="p625810-79" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="791" as="sourcePoint"/><mxPoint x="450" y="791" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p625810-80" value="GND" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="250" height="24" as="geometry"/></mxCell><mxCell id="p625810-81" value="&lt;b&gt;教育用の前提（検証済み回路図ではありません）&lt;/b&gt;&lt;br&gt;&lt;br&gt;• MCU の I/O とバッファは 3.3V、レベルシフタは既定でバイパス、アクチュエータは外部 5V。&lt;br&gt;• DIR は約 10kΩ でプルダウンし、既定で「受信」。DATA / RX を上拉する場合も 3.3V へ。&lt;br&gt;• 5V 電源を MCU の 3.3V I/O に接続してはいけません。&lt;br&gt;• 5V バッファの入力 High 閾値 0.7×VCC = 3.5V は 3.3V 応答を超えるため、3.3V バッファを既定としています。&lt;br&gt;• 実機の電圧・ピン・電源容量は選定部品の仕様で必ず確認してください。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="620" width="770" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. ソフトウェア構成" id="p257387"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p257387-2" value="&lt;b&gt;2. ソフトウェア構成：ファイル・クラス・依存関係&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p257387-3" value="PC 上のシミュレータ（app.py + protocol.py）と、実機に移植するための参考ファームウェア（firmware/）に分かれます。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p257387-4" value="&lt;b&gt;app.py  (1762 lines · Panda3D GUI)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="780" height="780" as="geometry"/></mxCell><mxCell id="p257387-5" value="&lt;b&gt;class Demo(ShowBase)  ― アプリ本体&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=14;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="p257387-4"><mxGeometry x="20" y="40" width="740" height="560" as="geometry"/></mxCell><mxCell id="p257387-6" value="&lt;b&gt;3D シーン&lt;/b&gt;  build_scene()&lt;br&gt;PC / MCU / レベルシフタ / バッファ / アクチュエータの箱、&lt;br&gt;配線（USB/TX/RX/DIR/DATA/GND/電源）、&lt;br&gt;モータのダイヤルと舵盤、world_text()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-5"><mxGeometry x="15" y="40" width="340" height="120" as="geometry"/></mxCell><mxCell id="p257387-7" value="&lt;b&gt;2D UI&lt;/b&gt;  build_ui() / resize_ui()&lt;br&gt;パネル：LEFT / VIEW / LENS / CODE / STEP / STRIP&lt;br&gt;部品：DirectButton / DirectEntry / DirectSlider /&lt;br&gt;DirectOptionMenu、byte_cells()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-5"><mxGeometry x="375" y="40" width="350" height="120" as="geometry"/></mxCell><mxCell id="p257387-8" value="&lt;b&gt;12 ステップ状態機械&lt;/b&gt;&lt;br&gt;load_packet() → next_step() ×12 → settle()&lt;br&gt;record() / stop() / packet_result()&lt;br&gt;STEPS 辞書（タイトル・解説・用語・コード位置）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-5"><mxGeometry x="15" y="175" width="340" height="120" as="geometry"/></mxCell><mxCell id="p257387-9" value="&lt;b&gt;アニメーション&lt;/b&gt;&lt;br&gt;Flight（バイトトークンの飛行）、later() タイマ、&lt;br&gt;wave_anim（波形カーソル）、tick() フレームループ、&lt;br&gt;速度 1× / 3×" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-5"><mxGeometry x="375" y="175" width="350" height="120" as="geometry"/></mxCell><mxCell id="p257387-10" value="&lt;b&gt;レンズ（拡大図）&lt;/b&gt;  set_lens() / draw_lens()&lt;br&gt;draw_mcu(): FIFO・シフトレジスタ・SRAM&lt;br&gt;draw_chip(): バッファの 2 つのゲート&lt;br&gt;draw_wave(): TX / DIR / FIFO_EMPTY / TX_COMPLETE" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-5"><mxGeometry x="15" y="310" width="340" height="120" as="geometry"/></mxCell><mxCell id="p257387-11" value="&lt;b&gt;コードビュー&lt;/b&gt;  load_firmware() / show_code()&lt;br&gt;main.c を読み込み、[NN] タグでステップと同期ハイライト&lt;br&gt;reset_fw() / refresh_vars() で変数表示" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-5"><mxGeometry x="375" y="310" width="350" height="120" as="geometry"/></mxCell><mxCell id="p257387-12" value="&lt;b&gt;角度制御フロー&lt;/b&gt;&lt;br&gt;FLOW / AUTO_FLOW、start_sequence()、&lt;br&gt;seq_next()（pos を最大 8 回ポーリング）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-5"><mxGeometry x="15" y="445" width="340" height="100" as="geometry"/></mxCell><mxCell id="p257387-13" value="&lt;b&gt;故障注入・出力&lt;/b&gt;&lt;br&gt;FAULTS ×8 + 電気プロファイル ×2、set_fault()&lt;br&gt;export() → output/trace-*.json" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-5"><mxGeometry x="375" y="445" width="350" height="100" as="geometry"/></mxCell><mxCell id="p257387-14" value="&lt;b&gt;class Flight&lt;/b&gt;&lt;br&gt;パスに沿って複数バイトを順に飛ばす。&lt;br&gt;on_depart / on_arrive / cut（途中で消える）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-4"><mxGeometry x="20" y="615" width="360" height="70" as="geometry"/></mxCell><mxCell id="p257387-15" value="&lt;b&gt;モジュール関数&lt;/b&gt;&lt;br&gt;box / poly2d / rect2d / lines2d（描画）、uart_bits()、&lt;br&gt;load_firmware()、render / freeze / run_packet / main()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-4"><mxGeometry x="400" y="615" width="360" height="70" as="geometry"/></mxCell><mxCell id="p257387-16" value="&lt;b&gt;定数&lt;/b&gt;  W,H=1600×1000 ／ MAX_BYTES=16（表示用 FIFO 深さ）／ MOTOR_DEMO_SPEED=260 ticks/s（アニメ用）／&lt;br&gt;FAULTS・STEPS・LENS_FOR_STEP・FLOW・AUTO_FLOW ／ 色: BG / CARD / ORANGE / GREEN / PURPLE …" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257387-4"><mxGeometry x="20" y="700" width="740" height="66" as="geometry"/></mxCell><mxCell id="p257387-17" value="&lt;b&gt;protocol.py  (168 lines · シリアル I/O なし)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="100" width="670" height="520" as="geometry"/></mxCell><mxCell id="p257387-18" value="&lt;b&gt;フレーミング関数&lt;/b&gt;&lt;br&gt;&lt;br&gt;HEADER = FF FF FD 00&lt;br&gt;crc16(data) — 多項式 0x8005、初期値 0&lt;br&gt;stuff() / unstuff() — バイトスタッフィング&lt;br&gt;packet(id, inst, params) — フレーム生成&lt;br&gt;parse(raw) → Packet — 検証＋分解&lt;br&gt;from_hex() / hexline() — HEX 変換&lt;br&gt;write() / read() / read_position() / status()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257387-17"><mxGeometry x="20" y="40" width="310" height="230" as="geometry"/></mxCell><mxCell id="p257387-19" value="&lt;b&gt;class Motor&lt;/b&gt;（教育用レジスタのサブセット）&lt;br&gt;&lt;br&gt;属性: device_id=1, torque, position, goal,&lt;br&gt;return_level=2, operating_mode=3, firmware_version=1,&lt;br&gt;speed=700 ticks/s（app が 260 に上書き）&lt;br&gt;&lt;br&gt;moving — torque ∧ |goal−pos|&amp;gt;1&lt;br&gt;update(dt) — 目標へ速度制限付きで移動&lt;br&gt;reply(Packet) → (応答 or None, 説明文)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257387-17"><mxGeometry x="345" y="40" width="310" height="230" as="geometry"/></mxCell><mxCell id="p257387-20" value="&lt;b&gt;@dataclass Packet&lt;/b&gt;(device_id, instruction, params)　　&lt;b&gt;電気モデルではありません&lt;/b&gt;：Motor はレジスタ挙動のみを模擬します。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257387-17"><mxGeometry x="20" y="285" width="635" height="70" as="geometry"/></mxCell><mxCell id="p257387-21" value="&lt;b&gt;本物の通信路は存在しない&lt;/b&gt;&lt;br&gt;app.py は serial / socket を一切開きません。Demo.next_step() が Motor.reply() を直接呼び、&lt;br&gt;MCU・バッファ・USB はアニメーションと状態変数としてだけ表現されます。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257387-17"><mxGeometry x="20" y="370" width="635" height="130" as="geometry"/></mxCell><mxCell id="p257387-22" value="&lt;b&gt;firmware/  （参考実装・ビルド不可）&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="650" width="670" height="230" as="geometry"/></mxCell><mxCell id="p257387-23" value="&lt;b&gt;board.h&lt;/b&gt;  — プラットフォーム適応インターフェース&lt;br&gt;&lt;br&gt;PC_UART / MOTOR_UART、board_init()、millis()&lt;br&gt;UART_GET_RX_EMPTY / UART_READ&lt;br&gt;UART_IS_TX_FULL / UART_WRITE&lt;br&gt;uart_tx_complete() — FIFO ＋ シフトレジスタ ＋ 停止ビット&lt;br&gt;gpio_write_dir(level)&lt;br&gt;PKT_MAX=64 / WAIT_FOREVER=0 / REPLY_TIMEOUT_MS=20" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257387-22"><mxGeometry x="20" y="40" width="310" height="175" as="geometry"/></mxCell><mxCell id="p257387-24" value="&lt;b&gt;main.c&lt;/b&gt;  — ブリッジ本体&lt;br&gt;&lt;br&gt;read_packet(uart, buf, timeout)&lt;br&gt;motor_send(p, len)&lt;br&gt;pc_write(p, len)&lt;br&gt;main() — 受信 → 送信 → 応答待ち → 転送&lt;br&gt;&lt;br&gt;[01]〜[12] タグ = GUI のステップ番号" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257387-22"><mxGeometry x="345" y="40" width="310" height="175" as="geometry"/></mxCell><mxCell id="p257387-25" value="&lt;b&gt;その他のファイル&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=15;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="910" width="780" height="200" as="geometry"/></mxCell><mxCell id="p257387-26" value="&lt;b&gt;test_protocol.py&lt;/b&gt;&lt;br&gt;unittest ×8&lt;br&gt;Ping ベクタ FF FF FD 00 01 03 00 01 19 4E、&lt;br&gt;スタッフィング、CRC/Length 拒否、&lt;br&gt;トルクと移動、ID 不一致、返信ポリシー" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="50" y="945" width="240" height="150" as="geometry"/></mxCell><mxCell id="p257387-27" value="&lt;b&gt;hardware.html&lt;/b&gt;&lt;br&gt;静的ドキュメント：配線 SVG、&lt;br&gt;OE の真理値表、DIR タイミング、&lt;br&gt;ソフト/ハードの分担、電圧閾値" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="945" width="240" height="150" as="geometry"/></mxCell><mxCell id="p257387-28" value="&lt;b&gt;start.cmd / requirements.txt / README.md&lt;/b&gt;&lt;br&gt;Windows 起動スクリプト（.venv を探す）&lt;br&gt;panda3d==1.10.16&lt;br&gt;環境変数 SERVO_LAB_FONT = 日本語/中国語フォント&lt;br&gt;output/ = スクリーンショット・trace JSON" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="550" y="945" width="240" height="150" as="geometry"/></mxCell><mxCell id="p257387-29" value="&lt;b&gt;外部依存: Panda3D 1.10.16&lt;/b&gt;&lt;br&gt;ShowBase / DirectGui / OffscreenBuffer / LineSegs" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="950" y="920" width="320" height="70" as="geometry"/></mxCell><mxCell id="p257387-30" value="&lt;b&gt;CJK フォント&lt;/b&gt;（Windows: msyh.ttc ほか、&lt;br&gt;または SERVO_LAB_FONT）— 無いと起動時に RuntimeError" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="920" width="330" height="70" as="geometry"/></mxCell><mxCell id="p257387-31" value="import" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1923;entryX=0;entryY=0.2885;" edge="1" parent="1" source="p257387-4" target="p257387-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p257387-32" value="main.c を&lt;br&gt;読むだけ" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.859;entryX=0;entryY=0.5217;" edge="1" parent="1" source="p257387-4" target="p257387-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p257387-33" value="継承 / 使用" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.9615;" edge="1" parent="1" source="p257387-29" target="p257387-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="955"/><mxPoint x="880" y="850"/></Array></mxGeometry></mxCell></root></mxGraphModel>