cSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-17" value="PC がパケットを組み立てる。&lt;br&gt;MCU は read_packet(PC_UART) で空待ち" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="130" y="206" width="760" height="60" as="geometry"/></mxCell><mxCell id="p678172-18" value="02" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="312" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-19" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E88E5;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="340" as="sourcePoint"/><mxPoint x="510" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p678172-20" value="HEX バイトを 1 つずつ送信（USB → HOST_RX）→ RX FIFO → UART_READ → g_buf[n]" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="238" y="296" width="264" height="40" as="geometry"/></mxCell><mxCell id="p678172-21" value="03" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="404" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-22" value="n が 7 に達したら need = 7 + Length を算出。n == need で 1 パケット完成" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="410" y="390" width="480" height="60" as="geometry"/></mxCell><mxCell id="p678172-23" value="04" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="496" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-24" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="524" as="sourcePoint"/><mxPoint x="1350" y="524" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p678172-25" value="gpio_write_dir(1)：DIR = 1 → 送信ゲート開・受信ゲート閉" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="798" y="480" width="544" height="40" as="geometry"/></mxCell><mxCell id="p678172-26" value="05" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="588" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-27" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E67E00;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="616" as="sourcePoint"/><mxPoint x="1630" y="616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p678172-28" value="UART_WRITE → TX FIFO → シフトレジスタ → ACT_TX → バッファ → DATA（1 ビットずつ）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1078" y="572" width="544" height="40" as="geometry"/></mxCell><mxCell id="p678172-29" value="06" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-30" value="while (!uart_tx_complete) ― 最後の停止ビットが出るまで待つ（FIFO 空では不可）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="690" y="666" width="760" height="60" as="geometry"/></mxCell><mxCell id="p678172-31" value="07" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="772" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-32" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="800" as="sourcePoint"/><mxPoint x="1350" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p678172-33" value="gpio_write_dir(0)：DIR = 0 → 送信出力ハイインピーダンス・受信ゲート開" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="798" y="756" width="544" height="40" as="geometry"/></mxCell><mxCell id="p678172-34" value="08" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="864" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-35" value="モータが ID / CRC を検査して実行。MCU は read_packet(MOTOR_UART, 20 ms) で待つ" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="690" y="850" width="1040" height="60" as="geometry"/></mxCell><mxCell id="p678172-36" value="09" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="956" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-37" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1630" y="984" as="sourcePoint"/><mxPoint x="1350" y="984" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p678172-38" value="約 0.5 ms（Return Delay）後、Status パケットを DATA へ送出 → 受信ゲートを通過" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1358" y="940" width="264" height="40" as="geometry"/></mxCell><mxCell id="p678172-39" value="10" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1048" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-40" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="1076" as="sourcePoint"/><mxPoint x="790" y="1076" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p678172-41" value="ACT_RX → UART1 シフトレジスタ → RX FIFO → UART_READ → g_rx（同じ read_packet）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="798" y="1032" width="544" height="40" as="geometry"/></mxCell><mxCell id="p678172-42" value="11" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1140" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-43" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E88E5;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="1168" as="sourcePoint"/><mxPoint x="230" y="1168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p678172-44" value="pc_write(g_rx, n)：1 バイトも変えずに UART0 → USB で PC へ転送" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="238" y="1124" width="544" height="40" as="geometry"/></mxCell><mxCell id="p678172-45" value="12" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1232" width="44" height="32" as="geometry"/></mxCell><mxCell id="p678172-46" value="PC がヘッダ / Length / CRC を検査。Instruction = 55、Error = 00。MCU はステップ 1 に戻る" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="130" y="1218" width="760" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7. ファームウェア フローチャート" id="p93607"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p93607-2" value="&lt;b&gt;7. firmware/main.c ：main() / read_packet() / motor_send() / pc_write()&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1640" height="36" as="geometry"/></mxCell><mxCell id="p93607-3" value="[NN] はコード内コメントのステップタグ。左：メインループ ／ 中：受信 ／ 右：送信と転送。丸の「A」は while (n &amp;lt; need) の先頭へ戻ることを表す。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="26" as="geometry"/></mxCell><mxCell id="p93607-4" value="&lt;b&gt;main()&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=15;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="440" height="1130" as="geometry"/></mxCell><mxCell id="p93607-5" value="board_init();  gpio_write_dir(0);" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="130" width="320" height="40" as="geometry"/></mxCell><mxCell id="p93607-6" value="[01][12]  len = read_packet(PC_UART, g_buf, WAIT_FOREVER)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="205" width="320" height="56" as="geometry"/></mxCell><mxCell id="p93607-7" value="len == 0 ?" style="html=1;whiteSpace=