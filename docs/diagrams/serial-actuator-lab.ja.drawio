 as="points"><mxPoint x="950" y="385"/><mxPoint x="1400" y="385"/></Array></mxGeometry></mxCell><mxCell id="p735655-17" value="その他" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1670.0" y="412.0" width="200" height="36" as="geometry"/></mxCell><mxCell id="p735655-18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p735655-7" target="p735655-17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="385"/><mxPoint x="1770" y="385"/></Array></mxGeometry></mxCell><mxCell id="p735655-19" value="params が空?" style="html=1;whiteSpace=wrap;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60.0" y="495.0" width="260" height="90" as="geometry"/></mxCell><mxCell id="p735655-20" value="status(err=5)&lt;br&gt;Ping 長さエラー" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="15.0" y="630.0" width="170" height="60" as="geometry"/></mxCell><mxCell id="p735655-21" value="status(params =&lt;br&gt;モデル 1 ＋ 版 1)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200.0" y="625.0" width="180" height="70" as="geometry"/></mxCell><mxCell id="p735655-22" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p735655-11" target="p735655-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p735655-23" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p735655-19" target="p735655-20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="540"/></Array></mxGeometry></mxCell><mxCell id="p735655-24" value="はい" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p735655-19" target="p735655-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="540"/></Array></mxGeometry></mxCell><mxCell id="p735655-25" value="Ping は Return Level に関係なく&lt;br&gt;必ず応答する" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="760" width="300" height="70" as="geometry"/></mxCell><mxCell id="p735655-26" value="len(params) == 4 ?" style="html=1;whiteSpace=wrap;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670.0" y="495.0" width="260" height="90" as="geometry"/></mxCell><mxCell id="p735655-27" value="status(err=5)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435.0" y="515.0" width="150" height="50" as="geometry"/></mxCell><mxCell id="p735655-28" value="(addr, len) を表で検索&lt;br&gt;(64,1) (68,1) (132,4)&lt;br&gt;(116,4) (11,1) (122,1)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;vertica