<mxfile host="app.diagrams.net" agent="build_drawio.py" version="24.0.0"><diagram name="1. ハードウェア構成と信号線" id="p625810"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p625810-2" value="&lt;b&gt;1. ハードウェア構成：PC → MCU → レベルシフタ → トライステートバッファ → アクチュエータ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1500" height="36" as="geometry"/></mxCell><mxCell id="p625810-3" value="hardware.html の配線図に対応。信号名は汎用の教育用名称で、特定ボードのピンではありません。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1500" height="26" as="geometry"/></mxCell><mxCell id="p625810-4" value="&lt;b&gt;基板上 3.3V ロジック電源&lt;/b&gt;&lt;br&gt;MCU の I/O 電源域と同じ（モータ電源ではない）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="330" height="56" as="geometry"/></mxCell><mxCell id="p625810-5" value="&lt;b&gt;外部安定化 5V&lt;/b&gt;&lt;br&gt;容量は実機の仕様で選定" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="90" width="220" height="56" as="geometry"/></mxCell><mxCell id="p625810-6" value="&lt;b&gt;PC&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="170" height="300" as="geometry"/></mxCell><mxCell id="p6258