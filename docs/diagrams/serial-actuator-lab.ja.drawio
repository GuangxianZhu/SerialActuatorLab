metry"/></mxCell><mxCell id="p736257-30" value="Instruction Packet（全バイト）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="432" width="440" height="36" as="geometry"/></mxCell><mxCell id="p736257-31" value="停止" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="432" width="40" height="36" as="geometry"/></mxCell><mxCell id="p736257-32" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="534" as="sourcePoint"/><mxPoint x="690" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-33" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="534" as="sourcePoint"/><mxPoint x="690" y="506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-34" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="506" as="sourcePoint"/><mxPoint x="1580" y="506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-35" value="最後のバイトがシフトレジスタへ移った時点で 1 に" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#555;fontSize=11;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="508" width="510" height="24" as="geometry"/></mxCell><mxCell id="p736257-36" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="604" as="sourcePoint"/><mxPoint x="800" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-37" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="604" as="sourcePoint"/><mxPoint x="800" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-38" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="576" as="sourcePoint"/><mxPoint x="1580" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-39" value="&lt;b&gt;最後の停止ビットが出終わって 1 に ← ここで DIR を下げる&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f7a3d;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="606" width="560" height="22" as="geometry"/></mxCell><mxCell id="p736257-40" value="Status Packet" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="642" width="480" height="36" as="geometry"/></mxCell><mxCell id="p736257-41" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f7a3d;strokeWidth=1;fontSize=11;fontColor=#333333;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="350" as="sourcePoint"/><mxPoint x="840" y="625" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-42" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333;strokeWidth=1;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="705" as="sourcePoint"/><mxPoint x="1060" y="705" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-43" value="約 500 µs（Return Delay、模擬値）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="708" width="220" height="22" as="geometry"/></mxCell><mxCell id="p736257-44" value="&lt;b&gt;誤ったタイミング（FIFO_EMPTY だけで DIR を下げる）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#C62828;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="900" height="24" as="geometry"/></mxCell><mxCell id="p736257-45" value="&lt;b&gt;DIR&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="818" width="130" height="24" as="geometry"/></mxCell><mxCell id="p736257-46" value="&lt;b&gt;DATA (TX側)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="888" width="130" height="24" as="geometry"/></mxCell><mxCell id="p736257-47" value="&lt;b&gt;モータ応答&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="958" width="130" height="24" as="geometry"/></mxCell><mxCell id="p736257-48" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="844" as="sourcePoint"/><mxPoint x="340" y="844" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-49" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="844" as="sourcePoint"/><mxPoint x="340" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-50" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="816" as="sourcePoint"/><mxPoint x="690" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-51" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C62828;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="816" as="sourcePoint"/><mxPoint x="690" y="844" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-52" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="844" as="sourcePoint"/><mxPoint x="1580" y="844" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p736257-53" value="Instruction Packet" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="882" width="330" height="36" as="geometry"/></mxCell><mxCell id="p736257-54" value="最後のバイトが切れる ✂" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="690" y="882" width="150" height="36" as="geometry"/></mxCell><mxCell id="p736257-55" value="&lt;b&gt;送信ゲートが早く閉じ最後のバイトが欠ける → CRC 不一致 → モータはパケット全体を破棄し応答しない → MCU は 20 ms でタイムアウト&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#C62828;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="710" y="846" width="950" height="40" as="geometry"/></mxCell><mxCell id="p736257-56" value="（応答なし）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="952" width="480" height="36" as="geometry"/></mxCell><mxCell id="p736257-57" value="&lt;b&gt;もう一つの失敗：DIR を 0 に戻さない&lt;/b&gt;　送信ゲートが DATA を占有し続け、受信ゲートも閉じたまま。モータは応答を送るが MCU に届かず、20 ms でタイムアウト。&lt;br&gt;&lt;b&gt;実機での確認&lt;/b&gt;　オシロスコープの 2 チャンネルを DATA と DIR_GPIO に当て、DIR の立ち下がりが最後の停止ビットより後ろにあるか確認する。GUI の波形は教育用の模式図で、実測ではありません。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="1020" width="1590" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="9. 角度制御フロー" id="p247595"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p247595-2" value="&lt;b&gt;9. 目標角度まで回す：自動フロー（Ping → モード確認 → トルク ON → 目標書込 → 位置ポーリング）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1640" height="36" as="geometry"/></mxCell><mxCell id="p247595-3" value="GUI 左パネルの FLOW / AUTO_FLOW。各ボタンは 1 パケットだけ送る。自動フローは ①〜⑤ を順に実行。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="26" as="geometry"/></mxCell><mxCell id="p247595-4" value="&lt;b&gt;①  Ping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 03 00 01 19 4E&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;ID 1 は在席か？&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="600" height="100" as="geometry"/></mxCell><mxCell id="p247595-5" value="&lt;b&gt;②  Read 11 番：動作モード&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 07 00 02 0B 00 01 00 22 47&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;3（位置制御）でないと角度指令が効かない&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="600" height="100" as="geometry"/></mxCell><mxCell id="p247595-6" value="&lt;b&gt;③  Write 64 番 = 1：トルク ON&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 06 00 03 40 00 01 DB 66&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;トルクが OFF だと目標を書いても回らない&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="600" height="100" as="geometry"/></mxCell><mxCell id="p247595-7" value="&lt;b&gt;④  Write 116 番：目標位置（例 90° = 1024）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 09 00 03 74 00 00 04 00 00 B2 89&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Write 成功は「受理」だけ。ここから回り始める&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="600" height="100" as="geometry"/></mxCell><mxCell id="p247595-8" value="&lt;b&gt;⑤  Read 132 番：現在位置&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 07 00 02 84 00 04 00 1D 15&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;目標 ±2 ticks 以内なら到達。未達なら再読込&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="600" height="100" as="geometry"/></mxCell><mxCell id="p247595-9" value="Error=0 かつ回包 OK" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p247595-4" target="p247595-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p247595-10" value="Error=0 かつ回包 OK" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p247595-5" target="p247595-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p247595-11" value="Error=0 かつ回包 OK" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p247595-6" target="p247595-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p247595-12" value="Error=0 かつ回包 OK" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p247595-7" target="p247595-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p247595-13" value="|現在位置 − 目標| ≤ 2&lt;br&gt;または ポーリング 8 回目?" style="html=1;whiteSpace=wrap;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="690" width="270" height="120" as="geometry"/></mxCell><mxCell id="p247595-14" value="Status 受信" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p247595-8" target="p247595-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p247595-15" value="いいえ：（1.2 s ÷ 速度）後に ⑤ をもう一度" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#E67E00;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p247595-13" target="p247595-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="880"/><mxPoint x="360" y="880"/></Array></mxGeometry></mxCell><mxCell id="p247595-16" value="完了（ボタンが「全フロー自動実行」に戻る）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="725" width="250" height="50" as="geometry"/></mxCell><mxCell id="p247595-17" value="はい" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p247595-13" target="p247595-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p247595-18" value="&lt;b&gt;⑥  Write 64 番 = 0：トルク OFF（任意）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 06 00 03 40 00 00 DE E6&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;モータを解放し手で回せる。自動フローには含まれず手動ボタンのみ&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="600" height="100" as="geometry"/></mxCell><mxCell id="p247595-19" value="&lt;b&gt;中断条件&lt;/b&gt;（seq_next）&lt;br&gt;いずれかのステップが ok でなければ自動フローを停止:&lt;br&gt;・Status が届かない（タイムアウト）&lt;br&gt;・CRC / Length 不一致&lt;br&gt;・Error ≠ 0&lt;br&gt;→「フロー中断」と表示し、以降のパケットは送らない" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="420" height="150" as="geometry"/></mxCell><mxCell id="p247595-20" value="&lt;b&gt;角度 → ticks&lt;/b&gt;&lt;br&gt;スライダ 0〜359° ／ 初期 90°&lt;br&gt;ticks = round(角度 × 4096 / 360) mod 4096&lt;br&gt;4 バイト LE：90° → &lt;span style=&quot;font-family:Courier New&quot;&gt;00 04 00 00&lt;/span&gt;&lt;br&gt;モータ初期位置 180°(2048)、表示用速度 260 ticks/s" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="290" width="420" height="140" as="geometry"/></mxCell><mxCell id="p247595-21" value="&lt;b&gt;パケット間の待ち&lt;/b&gt;&lt;br&gt;各パケット（12 ステップ）が終わると、&lt;br&gt;pos 以外は 1.6 s、pos は 1.2 s（÷ 速度）待って次を送る。&lt;br&gt;速度ボタン：低速（1×）/ 高速（3×）。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="460" width="420" height="120" as="geometry"/></mxCell><mxCell id="p247595-22" value="&lt;b&gt;自己検査の期待値（app.py --screenshot）&lt;/b&gt;&lt;br&gt;&lt;br&gt;・手順 kinds[:5] == [ping, mode, on, goal, pos]&lt;br&gt;・pos は 2 回以上（1 回目＝途中、2 回目＝到達）&lt;br&gt;・motor.goal == 1024 かつ |位置 − 1024| ≤ 2&lt;br&gt;・AUTO_FLOW の全ステップが ok&lt;br&gt;&lt;br&gt;&lt;b&gt;要点&lt;/b&gt;&lt;br&gt;Write の成功 ≠ 到達。必ず Read 132 で現在位置を確認する。&lt;br&gt;トルク ON を忘れると、目標は保存されても回らない。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="430" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="10. 故障実験" id="p756933"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p756933-2" value="&lt;b&gt;10. 故障実験（FAULTS ×8）と電気プロファイル（×2）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p756933-3" value="左パネルのプルダウンで選択。選択はパケット読み込み時に確定（active_fault）。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p756933-4" value="故障（GUI 表示名）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="270" height="38" as="geometry"/></mxCell><mxCell id="p756933-5" value="模擬の仕組み" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="380" height="38" as="geometry"/></mxCell><mxCell id="p756933-6" value="止まる/変わるステップ" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="420" height="38" as="geometry"/></mxCell><mxCell id="p756933-7" value="結果" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="520" height="38" as="geometry"/></mxCell><mxCell id="p756933-8" value="正常通信" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="138" width="270" height="58" as="geometry"/></mxCell><mxCell id="p756933-9" value="通常動作" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="138" width="380" height="58" as="geometry"/></mxCell><mxCell id="p756933-10" value="1 → 12 完走" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="138" width="420" height="58" as="geometry"/></mxCell><mxCell id="p756933-11" value="Status 受信、CRC OK" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="138" width="520" height="58" as="geometry"/></mxCell><mxCell id="p756933-12" value="FIFO_EMPTY だけ待って DIR 切替" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="196" width="270" height="58" as="geometry"/></mxCell><mxCell id="p756933-13" value="[06] を FIFO_EMPTY 待ちに置換" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="196" width="380" height="58" as="geometry"/></mxCell><mxCell id="p756933-14" value="6：波形の赤線／7：DIR が早く下がる／8：回包なし" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="196" width="420" height="58" as="geometry"/></mxCell><mxCell id="p756933-15" value="最後のバイトが欠損 → CRC 不一致 → モータは破棄 → 20 ms タイムアウト" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="196" width="520" height="58" as="geometry"/></mxCell><mxCell id="p756933-16" value="DIR を受信に戻さない" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="254" width="270" height="58" as="geometry"/></mxCell><mxCell id="p756933-17" value="[07] を実行しない（DIR=1 のまま）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="254" width="380" height="58" as="geometry"/></mxCell><mxCell id="p756933-18" value="7：行がスキップ／9：回包が門前払い" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="254" width="420" height="58" as="geometry"/></mxCell><mxCell id="p756933-19" value="モータは応答するが MCU に届かない → タイムアウト" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="254" width="520" height="58" as="geometry"/></mxCell><mxCell id="p756933-20" value="モータ未給電" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="312" width="270" height="58" as="geometry"/></mxCell><mxCell id="p756933-21" value="外部 5V なし" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="312" width="380" height="58" as="geometry"/></mxCell><mxCell id="p756933-22" value="8：回包なし" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="312" width="420" height="58" as="geometry"/></mxCell><mxCell id="p756933-23" value="MCU は 20 ms 待って return 0、何も PC へ転送しない" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="312" width="520" height="58" as="geometry"/></mxCell><mxCell id="p756933-24" value="共地なし" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="270" height="58" as="geometry"/></mxCell><mxCell id="p756933-25" value="共通の電圧基準がない（通信失敗として扱う）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="380" height="58" as="geometry"/></mxCell><mxCell id="p756933-26" value="8：回包なし" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="370" width="420" height="58" as="geometry"/></mxCell><mxCell id="p756933-27" value="実機の挙動は不確定、とされる" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="370" width="520" height="58" as="geometry"/></mxCell><mxCell id="p756933-28" value="ID 不一致" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="428" width="270" height="58" as="geometry"/></mxCell><mxCell id="p756933-29" value="load_packet() が ID を 2 に書換" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="428" width="380" height="58" as="geometry"/></mxCell><mxCell id="p756933-30" value="8：モータが無視" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="428" width="420" height="58" as="geometry"/></mxCell><mxCell id="p756933-31" value="Motor.reply() が None → 回包なし" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="428" width="520" height="58" as="geometry"/></mxCell><mxCell id="p756933-32" value="伝送中の CRC 破損" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="486" width="270" height="58" as="geometry"/></mxCell><mxCell id="p756933-33" value="線路でバイトが化けた" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="486" width="380" height="58" as="geometry"/></mxCell><mxCell id="p756933-34" value="8：回包なし" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="486" width="420" height="58" as="geometry"/></mxCell><mxCell id="p756933-35" value="CRC 不一致 → 実行も応答もしない" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="486" width="520" height="58" as="geometry"/></mxCell><mxCell id="p756933-36" value="Write は Status を返さない" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="544" width="270" height="58" as="geometry"/></mxCell><mxCell id="p756933-37" value="return_level を 1 に強制（policy_override）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="544" width="380" height="58" as="geometry"/></mxCell><mxCell id="p756933-38" value="8：書込は実行、9 以降なし" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="544" width="420" height="58" as="geometry"/></mxCell><mxCell id="p756933-39" value="「実行済みだが設定により無応答」。次の load_packet() で 2 に戻る" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="544" width="520" height="58" as="geometry"/></mxCell><mxCell id="p756933-40" value="電気：5V バッファ例（要確認）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="602" width="270" height="58" as="geometry"/></mxCell><mxCell id="p756933-41" value="VIH = 0.7×5V = 3.5V &amp;gt; 3.3V 応答" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="602" width="380" height="58" as="geometry"/></mxCell><mxCell id="p756933-42" value="8：リスク警告で停止" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="602" width="420" height="58" as="geometry"/></mxCell><mxCell id="p756933-43" value="「通信が確実かどうか判定不能」。必ず失敗する、という意味ではない" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="602" width="520" height="58" as="geometry"/></mxCell><mxCell id="p756933-44" value="&lt;b&gt;どの故障でも共通&lt;/b&gt;　stop() が呼ばれると finished=True、running=False。「タイムアウト：有効な Status を受信できません」を表示し、flow_state を fail にして自動フローを中断します（Write 無応答の場合のみ ok 扱い）。&lt;br&gt;&lt;b&gt;観察ポイント&lt;/b&gt;　実験前に「初期化」ボタンで状態を戻す。故障は次の「パケット読込」まで反映されない。&lt;br&gt;&lt;b&gt;既知の挙動&lt;/b&gt;　「ID 不一致」は Motor.reply() が None を返すため、画面上は「Status Return Level 設定による無応答」と同じ経路（実行済み・ok 扱い）で表示されます。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="1590" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="11. 画面レイアウト" id="p85091"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p85091-2" value="&lt;b&gt;11. シミュレータの画面（1600×1000 を 0.55 倍で表示）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p85091-3" value="app.py の矩形定数 LEFT / VIEW / LENS / CODE / STEP / STRIP と一致。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p85091-4" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#10192a;strokeColor=#10192a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="880.0000000000001" height="550.0" as="geometry"/></mxCell><mxCell id="p85091-5" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;Serial Actuator Communication Lab&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="108" width="400" height="30" as="geometry"/></mxCell><mxCell id="p85091-6" value="&lt;font color=&quot;#9fb3c8&quot;&gt;ハード・MCU 内部・ファームのコードを同期表示&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="132" width="600" height="20" as="geometry"/></mxCell><mxCell id="p85091-7" value="&lt;font color=&quot;#4de0a1&quot;&gt;シミュレーションモード・実機未接続&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1e3d33;strokeColor=#2a6a52;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="738.5" y="112.1" width="170.5" height="24.200000000000003" as="geometry"/></mxCell><mxCell id="p85091-8" value="&lt;b&gt;01 目標角度へ回す&lt;/b&gt;&lt;br&gt;&lt;br&gt;スライダ（0–359°）&lt;br&gt;[全フロー自動実行]&lt;br&gt;[低速][高速]&lt;br&gt;&lt;br&gt;① Ping&lt;br&gt;② Read 11&lt;br&gt;③ Write 64=1&lt;br&gt;④ Write 116&lt;br&gt;⑤ Read 132&lt;br&gt;⑥ Write 64=0&lt;br&gt;&lt;br&gt;故障実験メニュー&lt;br&gt;電気プロファイル&lt;br&gt;&lt;br&gt;モータ表盘&lt;br&gt;（現在角/目標）" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="51.0" y="159.4" width="148.5" height="426.8" as="geometry"/></mxCell><mxCell id="p85091-9" value="&lt;b&gt;02 ハードウェア（3D）&lt;/b&gt;　←/→ で回転&lt;br&gt;&lt;br&gt;PC — USB — MCU — レベルシフタ — 三態バッファ — アクチュエータ&lt;br&gt;USB青 · TX橙 · RX緑 · DIR紫 · DATA青緑&lt;br&gt;飛ぶ四角 = 転送中のバイト&lt;br&gt;&lt;br&gt;下部バッジ: DIR HIGH/LOW とゲートの状態" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="207.75" y="159.4" width="415.25000000000006" height="199.10000000000002" as="geometry"/></mxCell><mxCell id="p85091-10" value="&lt;b&gt;レンズ（拡大図）&lt;/b&gt;  [MCU 内部] [三態バッファ] [波形]&lt;br&gt;&lt;br&gt;MCU 内部: UART0/UART1 の移位レジスタ・FIFO(16)・SRAM g_buf/g_rx・DIR&lt;br&gt;三態バッファ: 送信/受信ゲートと /OE1・OE2&lt;br&gt;波形: TX・DIR・FIFO_EMPTY・TX_COMPLETE" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="207.75" y="365.1" width="415.25000000000006" height="221.10000000000002" as="geometry"/></mxCell><mxCell id="p85091-11" value="&lt;b&gt;03 ファーム firmware/main.c&lt;/b&gt;&lt;br&gt;現在位置 main() → read_packet(...)&lt;br&gt;&lt;br&gt;[NN] タグの行を黄色くハイライト&lt;br&gt;ステップごとに自動スクロール" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="631.25" y="159.4" width="277.75" height="253.00000000000003" as="geometry"/></mxCell><mxCell id="p85091-12" value="&lt;b&gt;操作・解説&lt;/b&gt;&lt;br&gt;HEX 入力（編集可）&lt;br&gt;[パケット読込][次へ][自動再生][再生し直す][初期化]&lt;br&gt;&lt;br&gt;ステップ見出し 01/12 …&lt;br&gt;やさしい説明＋用語メモ" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="631.25" y="419.0" width="277.75" height="167.20000000000002" as="geometry"/></mxCell><mxCell id="p85091-13" value="&lt;b&gt;バイトストリップ&lt;/b&gt;　TX PC → モータ（20 セル）／ RX モータ → PC（20 セル）　　デコード: ID · 命令 · 長さ · CRC OK／Error" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=middle;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="51.0" y="595.0" width="858.0000000000001" height="46.2" as="geometry"/></mxCell><mxCell id="p85091-14" value="&lt;b&gt;各ステップで自動的に切り替わるレンズ（LENS_FOR_STEP）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="600" height="24" as="geometry"/></mxCell><mxCell id="p85091-15" value="レンズ" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="200" height="40" as="geometry"/></mxCell><mxCell id="p85091-16" value="ステップ" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="400" height="40" as="geometry"/></mxCell><mxCell id="p85091-17" value="MCU 内部" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="200" height="40" as="geometry"/></mxCell><mxCell id="p85091-18" value="1, 2, 3, 5, 8, 10, 11, 12" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="160" width="400" height="40" as="geometry"/></mxCell><mxCell id="p85091-19" value="三態バッファ" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="200" width="200" height="40" as="geometry"/></mxCell><mxCell id="p85091-20" value="4, 7, 9" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="200" width="400" height="40" as="geometry"/></mxCell><mxCell id="p85091-21" value="波形" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="240" width="200" height="40" as="geometry"/></mxCell><mxCell id="p85091-22" value="6" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="240" width="400" height="40" as="geometry"/></mxCell><mxCell id="p85091-23" value="&lt;b&gt;キーボード・特殊動作&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="600" height="24" as="geometry"/></mxCell><mxCell id="p85091-24" value="• &lt;b&gt;Space&lt;/b&gt; ＝ 次へ（next_step）&lt;br&gt;• &lt;b&gt;←/→&lt;/b&gt; ＝ 3D 視点の回転 ±8°&lt;br&gt;• &lt;b&gt;Esc&lt;/b&gt; ＝ 終了&lt;br&gt;• ウィンドウサイズ変更に追従（resize_ui）&lt;br&gt;• &lt;b&gt;--screenshot&lt;/b&gt; ＝ オフスクリーンで自己検査 ＋ output/*.png を保存&lt;br&gt;• トレースの書き出し export() → output/trace-YYYYMMDD-HHMMSS.json&lt;br&gt;　　mode = SIMULATION_ONLY、hardware_tested = false&lt;br&gt;• 入力 HEX は 16 バイトまで（表示用 FIFO 深さ）、命令は 01/02/03 のみ" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="600" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="12. 実行時の状態機械とフレームループ" id="p986692"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p986692-2" value="&lt;b&gt;12. 実行時：パケットの状態遷移と tick() フレームループ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p986692-3" value="Demo の finished / running / step_index / seq の関係。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p986692-4" value="&lt;b&gt;待機&lt;/b&gt;&lt;br&gt;finished = True" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="240" height="100" as="geometry"/></mxCell><mxCell id="p986692-5" value="&lt;b&gt;読込済み&lt;/b&gt;&lt;br&gt;step_index = −1&lt;br&gt;finished = False" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="p986692-6" value="&lt;b&gt;ステップ実行中&lt;/b&gt;&lt;br&gt;step 1 … 12" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="280" height="100" as="geometry"/></mxCell><mxCell id="p986692-7" value="&lt;b&gt;完了&lt;/b&gt;&lt;br&gt;step 12 の後&lt;br&gt;finished = True" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="240" height="100" as="geometry"/></mxCell><mxCell id="p986692-8" value="&lt;b&gt;停止（失敗）&lt;/b&gt;&lt;br&gt;stop(): finished = True&lt;br&gt;flow_state = fail" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="280" height="100" as="geometry"/></mxCell><mxCell id="p986692-9" value="load_packet() 成功&lt;br&gt;（HEX / ボタン）" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-4" target="p986692-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-10" value="次へ ／ Space ／&lt;br&gt;自動再生" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-5" target="p986692-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-11" value="step 12 完了" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-6" target="p986692-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-12" value="各ステップ ＝ next_step() 1 回&lt;br&gt;（×12）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#555;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="108" width="180" height="36" as="geometry"/></mxCell><mxCell id="p986692-13" value="故障 ／ 回包なし ／ 電気リスク" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-6" target="p986692-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-14" value="「リプレイ」/ 新しい load_packet()" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="p986692-7" target="p986692-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="100"/><mxPoint x="180" y="100"/></Array></mxGeometry></mxCell><mxCell id="p986692-15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="p986692-8" target="p986692-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="390"/></Array></mxGeometry></mxCell><mxCell id="p986692-16" value="&lt;b&gt;load_packet() の入力検査&lt;/b&gt;&lt;br&gt;from_hex() → parse()（CRC / Length / ヘッダ）→ 命令 ∈ {1,2,3} → 長さ ≤ 16&lt;br&gt;NG なら「入力未送信」と表示して状態は変えない。OK なら飛行中のバイトを破棄、active_fault / active_profile を確定、return_level を調整、FW 変数を初期化し、デコード行を表示。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="640" height="115" as="geometry"/></mxCell><mxCell id="p986692-17" value="&lt;b&gt;settle()&lt;/b&gt;：次のステップへ進む前に、飛行中のバイト・タイマ・波形アニメを即座に完了させる（最大 200 回ループ）。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="690" height="70" as="geometry"/></mxCell><mxCell id="p986692-18" value="&lt;b&gt;tick(task)  ― 毎フレーム実行（taskMgr）&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="1590" height="440" as="geometry"/></mxCell><mxCell id="p986692-19" value="dt = min(frame dt, 0.1)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p986692-20" value="active_fault ≠「モータ未給電」なら&lt;br&gt;motor.update(dt)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p986692-21" value="refresh_motor()&lt;br&gt;ダイヤル・3D ホーン・テキスト" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p986692-22" value="timers：期限の来た&lt;br&gt;later() を実行" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p986692-23" value="wave_anim&lt;br&gt;波形カーソルを進める" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p986692-24" value="flights&lt;br&gt;Flight.update(now)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p986692-25" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-19" target="p986692-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-26" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-20" target="p986692-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-27" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-21" target="p986692-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-28" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-22" target="p986692-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-29" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-23" target="p986692-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-30" value="busy ＝ flights ∨ timers ∨ wave_anim" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="820" width="270" height="70" as="geometry"/></mxCell><mxCell id="p986692-31" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p986692-24" target="p986692-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-32" value="running ?" style="html=1;whiteSpace=wrap;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="810" width="250" height="90" as="geometry"/></mxCell><mxCell id="p986692-33" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p986692-30" target="p986692-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-34" value="busy なら step_done_at = 0。空いて 1.5 s ÷ speed 経過したら&lt;br&gt;&lt;b&gt;next_step()&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="815" width="380" height="80" as="geometry"/></mxCell><mxCell id="p986692-35" value="はい" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-32" target="p986692-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-36" value="&lt;b&gt;seq&lt;/b&gt; あり ∧ finished ∧ 非 busy ∧ next_at 経過&lt;br&gt;→ seq_next() → flow_click_seq()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="950" width="370" height="100" as="geometry"/></mxCell><mxCell id="p986692-37" value="いいえ" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p986692-32" target="p986692-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p986692-38" value="&lt;b&gt;速度&lt;/b&gt;  set_speed(1|3)&lt;br&gt;すべての遅延・移動時間を speed で割る。&lt;br&gt;&lt;br&gt;&lt;b&gt;自動フロー（seq）&lt;/b&gt;&lt;br&gt;start_sequence() → ping → mode → on → goal → pos（最大 8 回）&lt;br&gt;packet_result() が next_at を設定（1.6 s ／ pos は 1.2 s）&lt;br&gt;失敗すると seq = None で停止。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="420" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>