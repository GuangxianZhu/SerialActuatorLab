ill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p93607-64" target="p93607-65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p93607-70" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p93607-65" target="p93607-66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p93607-71" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p93607-66" target="p93607-67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p93607-72" value="&lt;b&gt;なぜ「FIFO 空」では駄目か&lt;/b&gt;&lt;br&gt;FIFO が空になった時点で、最後のバイトはまだシフトレジスタで送出中。そこで DIR を下げると送信ゲートが閉じて最後のバイトが切れ、CRC が壊れてモータはパケットを破棄します。（故障実験「FIFO_EMPTY だけ待って DIR を切替」で再現）&lt;br&gt;&lt;br&gt;&lt;b&gt;board.h の約束&lt;/b&gt;：uart_tx_complete() は最終停止ビットがピンを離れて初めて真。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1225" y="560" width="410" height="210" as="geometry"/></mxCell><mxCell id="p93607-73" value="&lt;b&gt;pc_write(p, len)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1190" y="830" width="480" height="390" as="geometry"/></mxCell><mxCell id="p93607-74" value="for i in 0..len-1:&lt;br&gt;while (UART_IS_TX_FULL(PC_UART)) {}" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1225" y="880" width="410" height="60" as="geometry"/></mxCell><mxCell id="p93607-75" value="[11]  UART_WRITE(PC_UART, p[i])&lt;br&gt;受信したバイトをそのまま転送" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1225" y="975" width="410" height="60" as="geometry"/></mxCell><mxCell id="p93607-76" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p93607-74" target="p93607-75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p93607-77" value="診断情報や追加バイトを混ぜない。&lt;br&gt;PC は元の Status をそのまま検査する。&lt;br&gt;board.h: PKT_MAX=64 / REPLY_TIMEOUT_MS=20 / WAIT_FOREVER=0" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1225" y="1070" width="410" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="8. DIR 制御とタイミング" id="p736257"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p736257-2" value="&lt;b&gt;8. DIR 1 本で 2 つのゲートを切り替える：真理値表とタイミング&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p736257-3" value="hardware.html の「一つの GPIO が二つのバッファを制御」と 12 ステップの [04]〜[07] に対応。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p736257-4" value="DIR" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="100" height="46" as="geometry"/></mxCell><mxCell id="p736257-5" value="1脚 /OE1（Low 有効）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="100" width="330" height="46" as="geometry"/></mxCell><mxCell id="p736257-6" value="7脚 OE2（High 有効）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="360" height="46" as="geometry"/></mxCell><mxCell id="p736257-7" value="結果" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="560" height="46" as="geometry"/></mxCell><mxCell id="p736257-8" value="1 / High" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="146" width="100" height="46" as="geometry"/></mxCell><mxCell id="p736257-9" value="High → 受信ゲート&lt;b&gt;閉&lt;/b&gt;" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="146" width="330" height="46" as="geometry"/></mxCell><mxCell id="p736257-10" value="High → 送信ゲート&lt;b&gt;開&lt;/b&gt;" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="146" width="360" height="46" as="geometry"/></mxCell><mxCell id="p736257-11" value="MCU TX → DATA → モータ（命令パケット送出）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="146" width="560" height="46" as="geometry"/></mxCell><mxCell id="p736257-12" value="0 / Low" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="192" width="100" height="46" as="geometry"/></mxCell><mxCell id="p736257-13" value="Low → 受信ゲート&lt;b&gt;開&lt;/b&gt;" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="192" width="330" height="46" as="geometry"/></mxCell><mxCell id="p736257-14" value="Low → 送信ゲート閉（ハイインピーダンス）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="192" width="360" height="46" as="geometry"/></mxCell><mxCell id="p736257-15" value="モータ DATA → MCU RX（Status 受信）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="192" width="560" height="46" as="geometry"/></mxCell><mxCell id="p736257-16" value="ハイインピーダンス ＝ 出力が「プラグを抜いた」状態で、1 も 0 も出さず DATA 線を占有しない。チップは Ping も CRC も知らず、いつ送り終わったかも分からない。DIR を切り替えるのは MCU ファームウェアの責任。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#444;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="1590" height="44" as="geometry"/></mxCell><mxCell id="p736257-17" value="&lt;b&gt;正しいタイミング（firmware の通り：uart_tx_complete を待つ）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f7a3d;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="305" width="900" height="24" as="geometry"/></mxCell><mxCell id="p736257-18" value="&lt;b&gt;DIR&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="368" width="130" height="24" as="geometry"/></mxCell><mxCell id="p736257-19" value="&lt;b&gt;DATA (TX側)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="438" width="130" height="24" as="geometry"/></mxCell><mxCell id="p736257-20" value="&lt;b&gt;FIFO_EMPTY&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="508" width="130" height="24" as="geometry"/></mxCell><mxCell id="p736257-21" value="&lt;b&gt;TX_COMPLETE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="578" width="130" height="24" as="geometry"/></mxCell><mxCell id="p736257-22" value="&lt;b&gt;DATA (応答)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="648" width="130" height="24" as="geometry"/></mxCell><mxCell id="p736257-23" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=