etry x="30" y="928" width="310" height="32" as="geometry"/></mxCell><mxCell id="p708737-101" value="FF FF FD 00 01 06 00 03 40 00 01 DB 66" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="928" width="560" height="32" as="geometry"/></mxCell><mxCell id="p708737-102" value="13" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="928" width="90" height="32" as="geometry"/></mxCell><mxCell id="p708737-103" value="Write 116 番 ＝ 1024（90°）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="310" height="32" as="geometry"/></mxCell><mxCell id="p708737-104" value="FF FF FD 00 01 09 00 03 74 00 00 04 00 00 B2 89" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="960" width="560" height="32" as="geometry"/></mxCell><mxCell id="p708737-105" value="16" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="90" height="32" as="geometry"/></mxCell><mxCell id="p708737-106" value="Read 132 番（現在位置 4B）" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="992" width="310" height="32" as="geometry"/></mxCell><mxCell id="p708737-107" value="FF FF FD 00 01 07 00 02 84 00 04 00 1D 15" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="992" width="560" height="32" as="geometry"/></mxCell><mxCell id="p708737-108" value="14" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="992" width="90" height="32" as="geometry"/></mxCell><mxCell id="p708737-109" value="&lt;b&gt;バイトスタッフィング&lt;/b&gt;&lt;br&gt;ボディ中に FF FF FD が現れたら直後に FD を 1 つ挿入し、&lt;br&gt;ヘッダと誤認されないようにする（受信側は FF FF FD FD → FF FF FD に戻す）。&lt;br&gt;例: params FF FF FD → ボディ FF FF FD &lt;b&gt;FD&lt;/b&gt;、Length が 1 増える。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1040" y="770" width="570" height="130" as="geometry"/></mxCell><mxCell id="p708737-110" value="&lt;b&gt;CRC-16&lt;/b&gt;　多項式 0x8005、初期値 0、MSB ファースト（非反転）。&lt;br&gt;ヘッダ〜パラメータの全バイトに対して計算し、&lt;b&gt;下位バイト先&lt;/b&gt;で末尾 2 バイトに付ける。&lt;br&gt;例: Ping → CRC = 19 4E" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1040" y="915" width="570" height="110" as="geometry"/></mxCell><mxCell id="p708737-111" value="&lt;b&gt;parse() の検証順序（失敗すると ValueError → GUI は「入力未送信」）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1060" width="900" height="22" as="geometry"/></mxCell><mxCell id="p708737-112" value="① 長さ≥10 かつ&lt;br&gt;ヘッダ FF FF FD 00" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p708737-113" value="② ID ≤ 252" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p708737-114" value="③ Length + 7&lt;br&gt;＝ 実バイト数" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p708737-115" value="④ CRC 一致" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p708737-116" value="⑤ スタッフィング&lt;br&gt;が正しい" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p708737-117" value="→ Packet(id,&lt;br&gt;inst, params)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p708737-118" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p708737-112" target="p708737-113"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p708737-119" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fo