Space=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="737" width="250" height="24" as="geometry"/></mxCell><mxCell id="p904190-71" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="791" as="sourcePoint"/><mxPoint x="110" y="791" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p904190-72" value="DIR: direction control" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="779" width="250" height="24" as="geometry"/></mxCell><mxCell id="p904190-73" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#0097B8;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="665" as="sourcePoint"/><mxPoint x="450" y="665" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p904190-74" value="DATA: half-duplex single wire" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="653" width="250" height="24" as="geometry"/></mxCell><mxCell id="p904190-75" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3D85C6;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="707" as="sourcePoint"/><mxPoint x="450" y="707" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p904190-76" value="3.3V logic supply" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="695" width="250" height="24" as="geometry"/></mxCell><mxCell id="p904190-77" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#D32F2F;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="749" as="sourcePoint"/><mxPoint x="450" y="749" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p904190-78" value="5V actuator supply" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="737" width="250" height="24" as="geometry"/></mxCell><mxCell id="p904190-79" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="791" as="sourcePoint"/><mxPoint x="450" y="791" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p904190-80" value="GND" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="250" height="24" as="geometry"/></mxCell><mxCell id="p904190-81" value="&lt;b&gt;Teaching assumptions (not a verified schematic)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• MCU I/O and buffer at 3.3V, level shifter bypassed by default, actuator on external 5V.&lt;br&gt;• DIR has a ~10kΩ pull-down, so the default state is &quot;receive&quot;. Any pull-up on DATA / RX goes to 3.3V.&lt;br&gt;• Never connect the 5V supply to MCU 3.3V I/O.&lt;br&gt;• A 5V buffer needs VIH = 0.7×VCC = 3.5V, above a 3.3V reply, so the model defaults to a 3.3V buffer.&lt;br&gt;• Check voltages, pins and supply capacity against the datasheets of the parts you choose." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="760" y="620" width="770" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Software architecture" id="p257531"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p257531-2" value="&lt;b&gt;2. Software architecture: files, classes and dependencies&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p257531-3" value="A PC-side simulator (app.py + protocol.py) and reference firmware (firmware/) meant to be ported to real hardware." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p257531-4" value="&lt;b&gt;app.py  (1762 lines · Panda3D GUI)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="780" height="780" as="geometry"/></mxCell><mxCell id="p257531-5" value="&lt;b&gt;class Demo(ShowBase)  — the application&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=14;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="p257531-4"><mxGeometry x="20" y="40" width="740" height="560" as="geometry"/></mxCell><mxCell id="p257531-6" value="&lt;b&gt;3D scene&lt;/b&gt;  build_scene()&lt;br&gt;Boxes for PC / MCU / shifter / buffer / actuator,&lt;br&gt;wires (USB/TX/RX/DIR/DATA/GND/power),&lt;br&gt;motor dial and horn, world_text()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-5"><mxGeometry x="15" y="40" width="340" height="120" as="geometry"/></mxCell><mxCell id="p257531-7" value="&lt;b&gt;2D UI&lt;/b&gt;  build_ui() / resize_ui()&lt;br&gt;Panels: LEFT / VIEW / LENS / CODE / STEP / STRIP&lt;br&gt;Widgets: DirectButton / DirectEntry / DirectSlider /&lt;br&gt;DirectOptionMenu, byte_cells()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-5"><mxGeometry x="375" y="40" width="350" height="120" as="geometry"/></mxCell><mxCell id="p257531-8" value="&lt;b&gt;12-step state machine&lt;/b&gt;&lt;br&gt;load_packet() → next_step() ×12 → settle()&lt;br&gt;record() / stop() / packet_result()&lt;br&gt;STEPS dict (title, text, term, code anchor)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-5"><mxGeometry x="15" y="175" width="340" height="120" as="geometry"/></mxCell><mxCell id="p257531-9" value="&lt;b&gt;Animation&lt;/b&gt;&lt;br&gt;Flight (byte tokens in flight), later() timers,&lt;br&gt;wave_anim (waveform cursor), tick() frame loop,&lt;br&gt;speed 1× / 3×" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-5"><mxGeometry x="375" y="175" width="350" height="120" as="geometry"/></mxCell><mxCell id="p257531-10" value="&lt;b&gt;Lens (zoom view)&lt;/b&gt;  set_lens() / draw_lens()&lt;br&gt;draw_mcu(): FIFO, shift register, SRAM&lt;br&gt;draw_chip(): the two buffer gates&lt;br&gt;draw_wave(): TX / DIR / FIFO_EMPTY / TX_COMPLETE" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-5"><mxGeometry x="15" y="310" width="340" height="120" as="geometry"/></mxCell><mxCell id="p257531-11" value="&lt;b&gt;Code view&lt;/b&gt;  load_firmware() / show_code()&lt;br&gt;Reads main.c, syncs highlight to steps via [NN] tags&lt;br&gt;reset_fw() / refresh_vars() show variables" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-5"><mxGeometry x="375" y="310" width="350" height="120" as="geometry"/></mxCell><mxCell id="p257531-12" value="&lt;b&gt;Angle-control flow&lt;/b&gt;&lt;br&gt;FLOW / AUTO_FLOW, start_sequence(),&lt;br&gt;seq_next() (polls pos up to 8 times)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-5"><mxGeometry x="15" y="445" width="340" height="100" as="geometry"/></mxCell><mxCell id="p257531-13" value="&lt;b&gt;Fault injection &amp; export&lt;/b&gt;&lt;br&gt;FAULTS ×8 + 2 electrical profiles, set_fault()&lt;br&gt;export() → output/trace-*.json" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-5"><mxGeometry x="375" y="445" width="350" height="100" as="geometry"/></mxCell><mxCell id="p257531-14" value="&lt;b&gt;class Flight&lt;/b&gt;&lt;br&gt;Moves byte tokens along a path in order.&lt;br&gt;on_depart / on_arrive / cut (vanish midway)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-4"><mxGeometry x="20" y="615" width="360" height="70" as="geometry"/></mxCell><mxCell id="p257531-15" value="&lt;b&gt;Module functions&lt;/b&gt;&lt;br&gt;box / poly2d / rect2d / lines2d (drawing), uart_bits(),&lt;br&gt;load_firmware(), render / freeze / run_packet / main()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-4"><mxGeometry x="400" y="615" width="360" height="70" as="geometry"/></mxCell><mxCell id="p257531-16" value="&lt;b&gt;Constants&lt;/b&gt;  W,H=1600×1000 / MAX_BYTES=16 (display FIFO depth) / MOTOR_DEMO_SPEED=260 ticks/s (animation) /&lt;br&gt;FAULTS, STEPS, LENS_FOR_STEP, FLOW, AUTO_FLOW / colours: BG / CARD / ORANGE / GREEN / PURPLE …" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="p257531-4"><mxGeometry x="20" y="700" width="740" height="66" as="geometry"/></mxCell><mxCell id="p257531-17" value="&lt;b&gt;protocol.py  (168 lines · no serial I/O)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="100" width="670" height="520" as="geometry"/></mxCell><mxCell id="p257531-18" value="&lt;b&gt;Framing functions&lt;/b&gt;&lt;br&gt;&lt;br&gt;HEADER = FF FF FD 00&lt;br&gt;crc16(data) — poly 0x8005, init 0&lt;br&gt;stuff() / unstuff() — byte stuffing&lt;br&gt;packet(id, inst, params) — build a frame&lt;br&gt;parse(raw) → Packet — validate + decode&lt;br&gt;from_hex() / hexline() — HEX conversion&lt;br&gt;write() / read() / read_position() / status()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257531-17"><mxGeometry x="20" y="40" width="310" height="230" as="geometry"/></mxCell><mxCell id="p257531-19" value="&lt;b&gt;class Motor&lt;/b&gt; (teaching register subset)&lt;br&gt;&lt;br&gt;attrs: device_id=1, torque, position, goal,&lt;br&gt;return_level=2, operating_mode=3, firmware_version=1,&lt;br&gt;speed=700 ticks/s (app overrides to 260)&lt;br&gt;&lt;br&gt;moving — torque ∧ |goal−pos|&amp;gt;1&lt;br&gt;update(dt) — move toward goal, rate limited&lt;br&gt;reply(Packet) → (response or None, note)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257531-17"><mxGeometry x="345" y="40" width="310" height="230" as="geometry"/></mxCell><mxCell id="p257531-20" value="&lt;b&gt;@dataclass Packet&lt;/b&gt;(device_id, instruction, params)　　&lt;b&gt;Not an electrical model&lt;/b&gt;: Motor only simulates register behaviour." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257531-17"><mxGeometry x="20" y="285" width="635" height="70" as="geometry"/></mxCell><mxCell id="p257531-21" value="&lt;b&gt;There is no real link&lt;/b&gt;&lt;br&gt;app.py never opens a serial port or socket. Demo.next_step() calls Motor.reply() directly;&lt;br&gt;the MCU, buffer and USB exist only as animation and state variables." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257531-17"><mxGeometry x="20" y="370" width="635" height="130" as="geometry"/></mxCell><mxCell id="p257531-22" value="&lt;b&gt;firmware/  (reference, not buildable)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="650" width="670" height="230" as="geometry"/></mxCell><mxCell id="p257531-23" value="&lt;b&gt;board.h&lt;/b&gt; — platform adaptation interface&lt;br&gt;&lt;br&gt;PC_UART / MOTOR_UART, board_init(), millis()&lt;br&gt;UART_GET_RX_EMPTY / UART_READ&lt;br&gt;UART_IS_TX_FULL / UART_WRITE&lt;br&gt;uart_tx_complete() — FIFO + shift reg + stop bit&lt;br&gt;gpio_write_dir(level)&lt;br&gt;PKT_MAX=64 / WAIT_FOREVER=0 / REPLY_TIMEOUT_MS=20" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257531-22"><mxGeometry x="20" y="40" width="310" height="175" as="geometry"/></mxCell><mxCell id="p257531-24" value="&lt;b&gt;main.c&lt;/b&gt; — the bridge itself&lt;br&gt;&lt;br&gt;read_packet(uart, buf, timeout)&lt;br&gt;motor_send(p, len)&lt;br&gt;pc_write(p, len)&lt;br&gt;main() — receive → send → wait → forward&lt;br&gt;&lt;br&gt;[01]–[12] tags = GUI step numbers" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p257531-22"><mxGeometry x="345" y="40" width="310" height="175" as="geometry"/></mxCell><mxCell id="p257531-25" value="&lt;b&gt;Other files&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=15;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="910" width="780" height="200" as="geometry"/></mxCell><mxCell id="p257531-26" value="&lt;b&gt;test_protocol.py&lt;/b&gt;&lt;br&gt;unittest ×8&lt;br&gt;Ping vector FF FF FD 00 01 03 00 01 19 4E,&lt;br&gt;stuffing, CRC/Length rejection,&lt;br&gt;torque gating, ID mismatch, reply policy" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="50" y="945" width="240" height="150" as="geometry"/></mxCell><mxCell id="p257531-27" value="&lt;b&gt;hardware.html&lt;/b&gt;&lt;br&gt;Static document: wiring SVG,&lt;br&gt;OE truth table, DIR timing,&lt;br&gt;software/hardware split, voltage threshold" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="945" width="240" height="150" as="geometry"/></mxCell><mxCell id="p257531-28" value="&lt;b&gt;start.cmd / requirements.txt / README.md&lt;/b&gt;&lt;br&gt;Windows launcher (finds .venv)&lt;br&gt;panda3d==1.10.16&lt;br&gt;env SERVO_LAB_FONT = CJK font file&lt;br&gt;output/ = screenshots and trace JSON" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="550" y="945" width="240" height="150" as="geometry"/></mxCell><mxCell id="p257531-29" value="&lt;b&gt;External: Panda3D 1.10.16&lt;/b&gt;&lt;br&gt;ShowBase / DirectGui / offscreen buffer / LineSegs" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="950" y="920" width="320" height="70" as="geometry"/></mxCell><mxCell id="p257531-30" value="&lt;b&gt;CJK font&lt;/b&gt; (Windows msyh.ttc etc.,&lt;br&gt;or SERVO_LAB_FONT) — RuntimeError at startup if none" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1290" y="920" width="330" heigh