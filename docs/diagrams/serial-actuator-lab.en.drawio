ontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="928" width="560" height="32" as="geometry"/></mxCell><mxCell id="p963902-102" value="13" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="928" width="90" height="32" as="geometry"/></mxCell><mxCell id="p963902-103" value="Write addr 116 = 1024 (90°)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="310" height="32" as="geometry"/></mxCell><mxCell id="p963902-104" value="FF FF FD 00 01 09 00 03 74 00 00 04 00 00 B2 89" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="960" width="560" height="32" as="geometry"/></mxCell><mxCell id="p963902-105" value="16" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="90" height="32" as="geometry"/></mxCell><mxCell id="p963902-106" value="Read addr 132 (present pos, 4B)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="992" width="310" height="32" as="geometry"/></mxCell><mxCell id="p963902-107" value="FF FF FD 00 01 07 00 02 84 00 04 00 1D 15" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="992" width="560" height="32" as="geometry"/></mxCell><mxCell id="p963902-108" value="14" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="992" width="90" height="32" as="geometry"/></mxCell><mxCell id="p963902-109" value="&lt;b&gt;Byte stuffing&lt;/b&gt;&lt;br&gt;If FF FF FD appears in the body, insert one extra FD after it&lt;br&gt;so it cannot be mistaken for a header (receiver turns FF FF FD FD back into FF FF FD).&lt;br&gt;Example: params FF FF FD → body FF FF FD &lt;b&gt;FD&lt;/b&gt;, Length grows by 1." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1040" y="770" width="570" height="130" as="geometry"/></mxCell><mxCell id="p963902-110" value="&lt;b&gt;CRC-16&lt;/b&gt;  polynomial 0x8005, init 0, MSB-first (non-reflected).&lt;br&gt;Computed over header … parameters; appended &lt;b&gt;low byte first&lt;/b&gt;.&lt;br&gt;Example: Ping → CRC = 19 4E" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1040" y="915" width="570" height="110" as="geometry"/></mxCell><mxCell id="p963902-111" value="&lt;b&gt;Validation order in parse() (any failure → ValueError → GUI shows &quot;input not sent&quot;)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1060" width="900" height="22" as="geometry"/></mxCell><mxCell id="p963902-112" value="① len ≥ 10 and&lt;br&gt;header FF FF FD 00" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p963902-113" value="② ID ≤ 252" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p963902-114" value="③ Length + 7&lt;br&gt;= actual bytes" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p963902-115" value="④ CRC matches" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p963902-116" value="⑤ stuffing is&lt;br&gt;well-formed" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p963902-117" value="→ Packet(id,&lt;br&gt;inst, params)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="1100" width="150" height="56" as="geometry"/></mxCell><mxCell id="p963902-118" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p963902-112" target="p963902-113"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p963902-119" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p963902-113" target="p963902-114"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p963902-120" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p963902-114" target="p963902-115"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p963902-121" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p963902-115" target="p963902-116"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p963902-122" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p963902-116" target="p963902-117"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p963902-123" value="load_packet() additionally requires &quot;instruction is 01/02/03&quot; and &quot;total length ≤ 16 bytes (display FIFO depth)&quot;." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#555;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1170" width="1200" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Registers &amp; motor model" id="p20179"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p20179-2" value="&lt;b&gt;4. Teaching motor: register map, reply policy and motion model&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fill