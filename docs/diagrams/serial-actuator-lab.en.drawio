ll id="p20179-49" value="4" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="384" width="60" height="44" as="geometry"/></mxCell><mxCell id="p20179-50" value="R" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="384" width="70" height="44" as="geometry"/></mxCell><mxCell id="p20179-51" value="ticks" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="384" width="190" height="44" as="geometry"/></mxCell><mxCell id="p20179-52" value="Current position, read with Read(132,4)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="384" width="380" height="44" as="geometry"/></mxCell><mxCell id="p20179-53" value="2048 (180°)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="384" width="160" height="44" as="geometry"/></mxCell><mxCell id="p20179-54" value="&lt;b&gt;Reply policy (Status Return Level)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="500" height="22" as="geometry"/></mxCell><mxCell id="p20179-55" value="Level" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="160" height="40" as="geometry"/></mxCell><mxCell id="p20179-56" value="Ping" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="480" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-57" value="Read" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-58" value="Write" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="480" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-59" value="0" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="160" height="40" as="geometry"/></mxCell><mxCell id="p20179-60" value="✔" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="520" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-61" value="✘" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="520" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-62" value="✘" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="520" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-63" value="1" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="160" height="40" as="geometry"/></mxCell><mxCell id="p20179-64" value="✔" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="560" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-65" value="✔" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="560" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-66" value="✘" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="560" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-67" value="2 (default)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="160" height="40" as="geometry"/></mxCell><mxCell id="p20179-68" value="✔" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="190" y="600" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-69" value="✔" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="600" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-70" value="✔" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="600" width="130" height="40" as="geometry"/></mxCell><mxCell id="p20179-71" value="Whether a Write replies depends on the Level &lt;b&gt;before&lt;/b&gt; the write (a Write that changes 2→1 is still answered). Error replies follow the same policy (Ping length error is always answered)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#444;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="550" height="70" as="geometry"/></mxCell><mxCell id="p20179-72" value="&lt;b&gt;Angle ↔ ticks&lt;/b&gt;&lt;br&gt;ticks = angle × 4096 ÷ 360 (GUI: round() mod 4096)&lt;br&gt;angle = ticks × 360 ÷ 4096&lt;br&gt;e.g. 90° = 1024, 180° = 2048, 359° = 4085&lt;br&gt;Goal is 4 bytes, little endian (90° → 00 04 00 00)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="480" height="130" as="geometry"/></mxCell><mxCell id="p20179-73" value="&lt;b&gt;Motion model  Motor.update(dt)&lt;/b&gt;&lt;br&gt;when torque = 1&lt;br&gt;position += clamp(goal − position, ±speed × dt)&lt;br&gt;speed = 700 ticks/s (Demo sets 260 ticks/s to slow the animation)&lt;br&gt;when torque = 0 the position never moves" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1110" y="450" width="510" height="130" as="geometry"/></mxCell><mxCell id="p20179-74" value="&lt;b&gt;Note: Write success ≠ arrival&lt;/b&gt;  Error = 0 only means the instruction was accepted. Arrival is checked by reading Present Position (132) and comparing with the goal (|Δ| ≤ 2 ticks).&lt;br&gt;In the GUI the position advances every frame in tick(), so a Read right after a Write returns a mid-move value." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="600" y="600" width="1020" height="110" as="geometry"/></mxCell><mxCell id="p20179-75" value="&lt;b&gt;Ping reply&lt;/b&gt;  params = 2-byte model number (LE, value 1) + 1-byte firmware version (value 1). Both are &lt;b&gt;simulated values&lt;/b&gt;, not detected from a real device. Ping always replies regardless of Return Level.&lt;br&gt;&lt;br&gt;&lt;b&gt;(address, length) pairs supported by Read&lt;/b&gt;  (64,1) (68,1) (132,4) (116,4) (11,1) (122,1) — anything else → Error 7.&lt;br&gt;&lt;b&gt;ID matching&lt;/b&gt;  if request.device_id ≠ 1 the whole packet is ignored (no reply). The GUI fault &quot;ID mismatch&quot; rewrites the ID to 2 to reproduce this." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="1590" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5. Motor.reply decision flow" id="p39030"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p39030-2" value="&lt;b&gt;5. Simulated motor logic: Motor.reply(request)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1840" height="36" as="geometry"/></mxCell><mxCell id="p39030-3" value="Returns (response or None, note). None means nothing is sent (the MCU times out after 20 ms)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1840" height="26" as="geometry"/></mxCell><mxCell id="p39030-4" value="reply(request)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840.0" y="87.0" width="220" height="36" as="geometry"/></mxCell><mxCell id="p39030-5" value="request.device_id == my ID (1)?" style="html=1;whiteSpace=wrap;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780.0" y="150.0" width="340" height="90" as="geometry"/></mxCell><mxCell id="p39030-6" value="None  &quot;ID mismatch: ignored&quot;&lt;br&gt;(no reply → timeout)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250.0" y="167.0" width="300" height="56" as="geometry"/></mxCell><mxCell id="p39030-7" value="request.instruction" style="html=1;whiteSpace=wrap;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800.0" y="275.0" width="300" height="90" as="geometry"/></mxCell><mxCell id="p39030-8" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p39030-4" target="p39030-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p39030-9" value="No" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p39030-5" target="p39030-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p39030-10" value="Yes" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p39030-5" target="p39030-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p39030-11" value="== 1  Ping" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90.0" y="412.0" width="200" height="36" as="geometry"/></mxCell><mxCell id="p39030-12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p39030-7" target="p39030-11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="385"/><mxPoint x="190" y="385"/></Array></mxGeometry></mxCell><mxCell id="p39030-13" value="== 2  Read" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700.0" y="412.0" width="200" height="36" as="geometry"/></mxCell><mxCell id="p39030-14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p39030-7" target="p39030-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="385"/><mxPoint x="800" y="385"/></Array></mxGeometry></mxCell><mxCell id="p39030-15" value="== 3  Write" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300.0" y="412.0" width="200" height="36" as="geometry"/></mxCell><mxCell id="p39030-16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p39030-7" target="p39030-15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="385"/><mxPoint x="1400" y="385"/></Array></mxGeometry></mxCell><mxCell id="p39030-17" value="other" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1670.0" y="412.0" width="200" height="36" as="geometry"/></mxCell><mxCell id="p39030-18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p39030-7" target="p39030-17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="385"/><mxPoint x="1770" y="385"/></Array></mxGeometry></mxCell><mxCell id="p39030-19" value="params empty?" style="html=1;whiteSpace=wrap;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60.0" y="495.0" width="260" height="90" as="geometry"/></mxCell><mxCell id="p39030-20" value="status(err=5)&lt;br&gt;Ping length error" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="15.0" y="630.0" width="170" height="60" as="geometry"/></mxCell><mxCell id="p39030-21" value="status(params =&lt;br&gt;model 1 + fw 1)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200.0" y="625.0" width="180" height="70" as="geometry"/></mxCell><mxCell id="p39030-22" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p39030-11" target="p39030-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p39030-23" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p39030-19" target="p39030-20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="540"/></Array></mxGeometry></mxCell><mxCell id="p39030-24" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p39030-19" target="p39030-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="540"/></Array></mxGeometry></mxCell><mxCell id="p39030-25" value="Ping is always answered&lt;br&gt;regardless of Return Level" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="760" width="300" height="70" as="geometry"/></mxCell><mxCell id="p39030-26" value="len(params) == 4 ?" style="html=1;wh