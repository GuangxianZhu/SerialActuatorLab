l><mxCell id="p483301-71" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p483301-66" target="p483301-67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p483301-72" value="&lt;b&gt;Why &quot;FIFO empty&quot; is not enough&lt;/b&gt;&lt;br&gt;When the FIFO empties the last byte is still being shifted out. Dropping DIR then closes the TX gate mid-byte, corrupting the CRC, and the actuator drops the packet (reproduced by the fault &quot;Only wait for FIFO_EMPTY&quot;).&lt;br&gt;&lt;br&gt;&lt;b&gt;board.h contract&lt;/b&gt;: uart_tx_complete() is true only after the final stop bit has left the pin." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1225" y="560" width="410" height="210" as="geometry"/></mxCell><mxCell id="p483301-73" value="&lt;b&gt;pc_write(p, len)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1190" y="830" width="480" height="390" as="geometry"/></mxCell><mxCell id="p483301-74" value="for i in 0..len-1:&lt;br&gt;while (UART_IS_TX_FULL(PC_UART)) {}" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1225" y="880" width="410" height="60" as="geometry"/></mxCell><mxCell id="p483301-75" value="[11]  UART_WRITE(PC_UART, p[i])&lt;br&gt;forward each received byte as is" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1225" y="975" width="410" height="60" as="geometry"/></mxCell><mxCell id="p483301-76" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p483301-74" target="p483301-75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p483301-77" value="No diagnostics or extra bytes are mixed in.&lt;br&gt;The PC verifies the original Status unchanged.&lt;br&gt;board.h: PKT_MAX=64 / REPLY_TIMEOUT_MS=20 / WAIT_FOREVER=0" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1225" y="1070" width="410" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="8. DIR control &amp; timing" id="p934635"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p934635-2" value="&lt;b&gt;8. One DIR line drives both gates: truth table and timing&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p934635-3" value="Corresponds to &quot;one GPIO controls two buffers&quot; in hardware.html and steps [04]–[07]." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p934635-4" value="DIR" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="100" height="46" as="geometry"/></mxCell><mxCell id="p934635-5" value="pin 1 /OE1 (active low)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="100" width="330" height="46" as="geometry"/></mxCell><mxCell id="p934635-6" value="pin 7 OE2 (active high)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="360" height="46" as="geometry"/></mxCell><mxCell id="p934635-7" value="Result" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="560" height="46" as="geometry"/></mxCell><mxCell id="p934635-8" value="1 / High" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="146" width="100" height="46" as="geometry"/></mxCell><mxCell id="p934635-9" value="High → RX gate &lt;b&gt;closed&lt;/b&gt;" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="146" width="330" height="46" as="geometry"/></mxCell><mxCell id="p934635-10" value="High → TX gate &lt;b&gt;open&lt;/b&gt;" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="146" width="360" height="46" as="geometry"/></mxCell><mxCell id="p934635-11" value="MCU TX → DATA → actuator (sending the instruction)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="146" width="560" height="46" as="geometry"/></mxCell><mxCell id="p934635-12" value="0 / Low" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="192" width="100" height="46" as="geometry"/></mxCell><mxCell id="p934635-13" value="Low → RX gate &lt;b&gt;open&lt;/b&gt;" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="192" width="330" height="46" as="geometry"/></mxCell><mxCell id="p934635-14" value="Low → TX gate closed (Hi-Z)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="192" width="360" height="46" as="geometry"/></mxCell><mxCell id="p934635-15" value="actuator DATA → MCU RX (receiving the Status)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="192" width="560" height="46" as="geometry"/></mxCell><mxCell id="p934635-16" value="Hi-Z = the output is &quot;unplugged&quot;: it drives neither 1 nor 0 and leaves DATA free. The chip knows nothing about Ping, CRC or when a frame ends. Switching DIR is the MCU firmware&#x27;s job." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#444;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="1590" height="44" as="geometry"/></mxCell><mxCell id="p934635-17" value="&lt;b&gt;Correct timing (as in firmware: wait for uart_tx_complete)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f7a3d;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="305" width="900" height="24" as="geometry"/></mxCell><mxCell id="p934635-18" value="&lt;b&gt;DIR&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="368" width="130" height="24" as="geometry"/></mxCell><mxCell id="p934635-19" value="&lt;b&gt;DATA (TX)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="438" width="130" height="24" as="geometry"/></mxCell><mxCell id="p934635-20" value="&lt;b&gt;FIFO_EMPTY&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="508" width="130" height="24" as="geometry"/></mxCell><mxCell id="p934635-21" value="&lt;b&gt;TX_COMPLETE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="578" width="130" height="24" as="geometry"/></mxCell><mxCell id="p934635-22" value="&lt;b&gt;DATA (reply)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="648" width="130" height="24" as="geometry"/></mxCell><mxCell id="p934635-23" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="394" as="sourcePoint"/><mxPoint x="340" y="394" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-24" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="394" as="sourcePoint"/><mxPoint x="340" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-25" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="366" as="sourcePoint"/><mxPoint x="840" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-26" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="366" as="sourcePoint"/><mxPoint x="840" y="394" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-27" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="394" as="sourcePoint"/><mxPoint x="1580" y="394" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-28" value="1: sending (instruction packet)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#7E57C2;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="340" width="400" height="22" as="geometry"/></mxCell><mxCell id="p934635-29" value="0: Hi-Z, waiting / receiving" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#7E57C2;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="396" width="400" height="22" as="geometry"/></mxCell><mxCell id="p934635-30" value="Instruction Packet (all bytes)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="432" width="440" height="36" as="geometry"/></mxCell><mxCell id="p934635-31" value="stop" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="432" width="40" height="36" as="geometry"/></mxCell><mxCell id="p934635-32" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="534" as="sourcePoint"/><mxPoint x="690" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-33" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="534" as="sourcePoint"/><mxPoint x="690" y="506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-34" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="506" as="sourcePoint"/><mxPoint x="1580" y="506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-35" value="goes 1 when the last byte moves into the shift register" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#555;fontSize=11;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="508" width="510" height="24" as="geometry"/></mxCell><mxCell id="p934635-36" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="604" as="sourcePoint"/><mxPoint x="800" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-37" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="604" as="sourcePoint"/><mxPoint x="800" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-38" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#555;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="576" as="sourcePoint"/><mxPoint x="1580" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-39" value="&lt;b&gt;goes 1 once the last stop bit is out ← drop DIR here&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f7a3d;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="606" width="560" height="22" as="geometry"/></mxCell><mxCell id="p934635-40" value="Status Packet" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="642" width="480" height="36" as="geometry"/></mxCell><mxCell id="p934635-41" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f7a3d;strokeWidth=1;fontSize=11;fontColor=#333333;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="350" as="sourcePoint"/><mxPoint x="840" y="625" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-42" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333;strokeWidth=1;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="705" as="sourcePoint"/><mxPoint x="1060" y="705" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-43" value="~500 µs (Return Delay, simulated)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="708" width="220" height="22" as="geometry"/></mxCell><mxCell id="p934635-44" value="&lt;b&gt;Wrong timing (dropping DIR as soon as FIFO_EMPTY)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#C62828;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="900" height="24" as="geometry"/></mxCell><mxCell id="p934635-45" value="&lt;b&gt;DIR&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="818" width="130" height="24" as="geometry"/></mxCell><mxCell id="p934635-46" value="&lt;b&gt;DATA (TX)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="888" width="130" height="24" as="geometry"/></mxCell><mxCell id="p934635-47" value="&lt;b&gt;Actuator reply&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="958" width="130" height="24" as="geometry"/></mxCell><mxCell id="p934635-48" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="844" as="sourcePoint"/><mxPoint x="340" y="844" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-49" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="844" as="sourcePoint"/><mxPoint x="340" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-50" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="816" as="sourcePoint"/><mxPoint x="690" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-51" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C62828;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="816" as="sourcePoint"/><mxPoint x="690" y="844" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-52" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=3;fontSize=11;fontColor=#333333;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="844" as="sourcePoint"/><mxPoint x="1580" y="844" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p934635-53" value="Instruction Packet" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="882" width="330" height="36" as="geometry"/></mxCell><mxCell id="p934635-54" value="last byte cut off ✂" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="690" y="882" width="150" height="36" as="geometry"/></mxCell><mxCell id="p934635-55" value="&lt;b&gt;The TX gate closes early so the last byte is lost → CRC mismatch → the actuator discards the whole packet and stays silent → the MCU times out after 20 ms&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#C62828;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="710" y="846" width="950" height="40" as="geometry"/></mxCell><mxCell id="p934635-56" value="(no reply)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="952" width="480" height="36" as="geometry"/></mxCell><mxCell id="p934635-57" value="&lt;b&gt;Another failure: DIR never returns to 0&lt;/b&gt;  The TX gate keeps occupying DATA and the RX gate stays closed. The actuator replies but the MCU never hears it → 20 ms timeout.&lt;br&gt;&lt;b&gt;Verify on hardware&lt;/b&gt;  Probe DATA and DIR_GPIO with an oscilloscope and check that the DIR falling edge lands after the last stop bit. The GUI waveform is a teaching sketch, not a measurement." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="1020" width="1590" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="9. Angle-control flow" id="p368440"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p368440-2" value="&lt;b&gt;9. Turning to a target angle: the automatic flow (Ping → mode → torque on → write goal → poll position)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1640" height="36" as="geometry"/></mxCell><mxCell id="p368440-3" value="FLOW / AUTO_FLOW in the left panel. Each button sends a single packet; the automatic flow runs ①–⑤." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1640" height="26" as="geometry"/></mxCell><mxCell id="p368440-4" value="&lt;b&gt;①  Ping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 03 00 01 19 4E&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Is ID 1 there?&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="600" height="100" as="geometry"/></mxCell><mxCell id="p368440-5" value="&lt;b&gt;②  Read addr 11: operating mode&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 07 00 02 0B 00 01 00 22 47&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;must equal 3 (position control) for angle commands&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="600" height="100" as="geometry"/></mxCell><mxCell id="p368440-6" value="&lt;b&gt;③  Write addr 64 = 1: torque ON&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 06 00 03 40 00 01 DB 66&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;with torque OFF, writing a goal does not move it&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="600" height="100" as="geometry"/></mxCell><mxCell id="p368440-7" value="&lt;b&gt;④  Write addr 116: goal (e.g. 90° = 1024)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 09 00 03 74 00 00 04 00 00 B2 89&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;success only means &quot;accepted&quot;; the motor starts moving&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="600" height="100" as="geometry"/></mxCell><mxCell id="p368440-8" value="&lt;b&gt;⑤  Read addr 132: present position&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 07 00 02 84 00 04 00 1D 15&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;within ±2 ticks of the goal = arrived; otherwise read again&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="600" height="100" as="geometry"/></mxCell><mxCell id="p368440-9" value="reply OK, Error = 0" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p368440-4" target="p368440-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p368440-10" value="reply OK, Error = 0" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p368440-5" target="p368440-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p368440-11" value="reply OK, Error = 0" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p368440-6" target="p368440-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p368440-12" value="reply OK, Error = 0" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p368440-7" target="p368440-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p368440-13" value="|position − goal| ≤ 2&lt;br&gt;or 8 polls done?" style="html=1;whiteSpace=wrap;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="690" width="270" height="120" as="geometry"/></mxCell><mxCell id="p368440-14" value="Status received" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p368440-8" target="p368440-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p368440-15" value="No: read ⑤ again after (1.2 s ÷ speed)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#E67E00;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p368440-13" target="p368440-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="880"/><mxPoint x="360" y="880"/></Array></mxGeometry></mxCell><mxCell id="p368440-16" value="Done (button returns to &quot;Run whole flow&quot;)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="725" width="250" height="50" as="geometry"/></mxCell><mxCell id="p368440-17" value="Yes" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p368440-13" target="p368440-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p368440-18" value="&lt;b&gt;⑥  Write addr 64 = 0: torque OFF (optional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:Courier New&quot;&gt;FF FF FD 00 01 06 00 03 40 00 00 DE E6&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;releases the motor so it can be turned by hand; manual button only, not in the automatic flow&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="600" height="100" as="geometry"/></mxCell><mxCell id="p368440-19" value="&lt;b&gt;Abort rule&lt;/b&gt; (seq_next)&lt;br&gt;If any step is not ok the automatic flow stops:&lt;br&gt;• no Status (timeout)&lt;br&gt;• CRC / Length mismatch&lt;br&gt;• Error ≠ 0&lt;br&gt;→ shows &quot;flow interrupted&quot; and sends nothing further" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="420" height="150" as="geometry"/></mxCell><mxCell id="p368440-20" value="&lt;b&gt;Angle → ticks&lt;/b&gt;&lt;br&gt;slider 0–359°, default 90°&lt;br&gt;ticks = round(angle × 4096 / 360) mod 4096&lt;br&gt;4-byte LE: 90° → &lt;span style=&quot;font-family:Courier New&quot;&gt;00 04 00 00&lt;/span&gt;&lt;br&gt;motor starts at 180° (2048), display speed 260 ticks/s" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="290" width="420" height="140" as="geometry"/></mxCell><mxCell id="p368440-21" value="&lt;b&gt;Pause between packets&lt;/b&gt;&lt;br&gt;After each packet finishes (12 steps) the flow waits&lt;br&gt;1.6 s (1.2 s for pos) ÷ speed, then sends the next.&lt;br&gt;Speed buttons: Slow (1×) / Fast (3×)." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="460" width="420" height="120" as="geometry"/></mxCell><mxCell id="p368440-22" value="&lt;b&gt;Expected self-check (app.py --screenshot)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• sequence kinds[:5] == [ping, mode, on, goal, pos]&lt;br&gt;• pos appears ≥ 2 times (1st = midway, 2nd = arrived)&lt;br&gt;• motor.goal == 1024 and |position − 1024| ≤ 2&lt;br&gt;• every AUTO_FLOW step is ok&lt;br&gt;&lt;br&gt;&lt;b&gt;Take-aways&lt;/b&gt;&lt;br&gt;Write success ≠ arrival. Always confirm with Read 132.&lt;br&gt;Forget torque ON and the goal is stored but nothing moves." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="430" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="10. Fault experiments" id="p237569"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p237569-2" value="&lt;b&gt;10. Fault injection (FAULTS ×8) and electrical profiles (×2)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p237569-3" value="Chosen in the left-panel drop-downs. The choice is latched when a packet is loaded (active_fault)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p237569-4" value="Fault (GUI label)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="270" height="38" as="geometry"/></mxCell><mxCell id="p237569-5" value="How it is simulated" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="380" height="38" as="geometry"/></mxCell><mxCell id="p237569-6" value="Step affected" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="420" height="38" as="geometry"/></mxCell><mxCell id="p237569-7" value="Outcome" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="520" height="38" as="geometry"/></mxCell><mxCell id="p237569-8" value="Normal" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="138" width="270" height="58" as="geometry"/></mxCell><mxCell id="p237569-9" value="Nominal" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="138" width="380" height="58" as="geometry"/></mxCell><mxCell id="p237569-10" value="1 → 12 complete" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="138" width="420" height="58" as="geometry"/></mxCell><mxCell id="p237569-11" value="Status received, CRC OK" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="138" width="520" height="58" as="geometry"/></mxCell><mxCell id="p237569-12" value="Only wait for FIFO_EMPTY, then switch DIR" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="196" width="270" height="58" as="geometry"/></mxCell><mxCell id="p237569-13" value="[06] replaced by a FIFO_EMPTY wait" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="196" width="380" height="58" as="geometry"/></mxCell><mxCell id="p237569-14" value="6: red line on waveform / 7: DIR drops early / 8: no reply" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="196" width="420" height="58" as="geometry"/></mxCell><mxCell id="p237569-15" value="last byte truncated → CRC mismatch → actuator discards → 20 ms timeout" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="196" width="520" height="58" as="geometry"/></mxCell><mxCell id="p237569-16" value="DIR not returned to receive" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="254" width="270" height="58" as="geometry"/></mxCell><mxCell id="p237569-17" value="[07] skipped (DIR stays 1)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="254" width="380" height="58" as="geometry"/></mxCell><mxCell id="p237569-18" value="7: line skipped / 9: reply blocked at the gate" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="254" width="420" height="58" as="geometry"/></mxCell><mxCell id="p237569-19" value="actuator replies but the MCU never hears it → timeout" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="254" width="520" height="58" as="geometry"/></mxCell><mxCell id="p237569-20" value="Actuator unpowered" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="312" width="270" height="58" as="geometry"/></mxCell><mxCell id="p237569-21" value="no external 5V" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="312" width="380" height="58" as="geometry"/></mxCell><mxCell id="p237569-22" value="8: no reply" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="312" width="420" height="58" as="geometry"/></mxCell><mxCell id="p237569-23" value="MCU waits 20 ms, read_packet returns 0, nothing reaches the PC" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="312" width="520" height="58" as="geometry"/></mxCell><mxCell id="p237569-24" value="No common ground" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="270" height="58" as="geometry"/></mxCell><mxCell id="p237569-25" value="no shared voltage reference (treated as failure)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="380" height="58" as="geometry"/></mxCell><mxCell id="p237569-26" value="8: no reply" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="370" width="420" height="58" as="geometry"/></mxCell><mxCell id="p237569-27" value="real behaviour is undefined; shown as failure" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="370" width="520" height="58" as="geometry"/></mxCell><mxCell id="p237569-28" value="ID mismatch" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="428" width="270" height="58" as="geometry"/></mxCell><mxCell id="p237569-29" value="load_packet() rewrites the ID to 2" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="428" width="380" height="58" as="geometry"/></mxCell><mxCell id="p237569-30" value="8: actuator ignores it" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="428" width="420" height="58" as="geometry"/></mxCell><mxCell id="p237569-31" value="Motor.reply() returns None → no reply" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="428" width="520" height="58" as="geometry"/></mxCell><mxCell id="p237569-32" value="CRC corrupted in transit" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="486" width="270" height="58" as="geometry"/></mxCell><mxCell id="p237569-33" value="a byte is garbled on the wire" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="486" width="380" height="58" as="geometry"/></mxCell><mxCell id="p237569-34" value="8: no reply" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="486" width="420" height="58" as="geometry"/></mxCell><mxCell id="p237569-35" value="CRC mismatch → neither executes nor replies" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="486" width="520" height="58" as="geometry"/></mxCell><mxCell id="p237569-36" value="Write returns no Status" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="544" width="270" height="58" as="geometry"/></mxCell><mxCell id="p237569-37" value="return_level forced to 1 (policy_override)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="544" width="380" height="58" as="geometry"/></mxCell><mxCell id="p237569-38" value="8: write executes, nothing after" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="544" width="420" height="58" as="geometry"/></mxCell><mxCell id="p237569-39" value="&quot;executed, no reply by setting&quot;; restored to 2 on the next load_packet()" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="544" width="520" height="58" as="geometry"/></mxCell><mxCell id="p237569-40" value="Electrical: example 5V buffer (to verify)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="602" width="270" height="58" as="geometry"/></mxCell><mxCell id="p237569-41" value="VIH = 0.7×5V = 3.5V &amp;gt; a 3.3V reply" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="602" width="380" height="58" as="geometry"/></mxCell><mxCell id="p237569-42" value="8: stops with a risk warning" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="602" width="420" height="58" as="geometry"/></mxCell><mxCell id="p237569-43" value="&quot;cannot judge reliability&quot; — a conservative warning, not a measured failure" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="602" width="520" height="58" as="geometry"/></mxCell><mxCell id="p237569-44" value="&lt;b&gt;Common to all faults&lt;/b&gt;  stop() sets finished=True, running=False, shows &quot;timeout: no valid Status&quot; and marks the flow step failed, aborting the automatic flow (only the &quot;Write returns no Status&quot; case is marked ok).&lt;br&gt;&lt;b&gt;Tip&lt;/b&gt;  Press Reset before an experiment. A fault only takes effect when the next packet is loaded.&lt;br&gt;&lt;b&gt;Known behaviour&lt;/b&gt;  &quot;ID mismatch&quot; makes Motor.reply() return None, so the screen takes the same path as &quot;no reply due to Status Return Level&quot; (shown as executed / ok)." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="1590" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="11. UI layout" id="p925856"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p925856-2" value="&lt;b&gt;11. Simulator window (1600×1000 shown at 0.55×)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p925856-3" value="Matches the rectangle constants LEFT / VIEW / LENS / CODE / STEP / STRIP in app.py." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p925856-4" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#10192a;strokeColor=#10192a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="880.0000000000001" height="550.0" as="geometry"/></mxCell><mxCell id="p925856-5" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;Serial Actuator Communication Lab&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="108" width="400" height="30" as="geometry"/></mxCell><mxCell id="p925856-6" value="&lt;font color=&quot;#9fb3c8&quot;&gt;Hardware, MCU internals and firmware code stay in sync&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="132" width="600" height="20" as="geometry"/></mxCell><mxCell id="p925856-7" value="&lt;font color=&quot;#4de0a1&quot;&gt;Simulation mode · no hardware&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1e3d33;strokeColor=#2a6a52;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="738.5" y="112.1" width="170.5" height="24.200000000000003" as="geometry"/></mxCell><mxCell id="p925856-8" value="&lt;b&gt;01 Turn to angle&lt;/b&gt;&lt;br&gt;&lt;br&gt;slider (0–359°)&lt;br&gt;[Run whole flow]&lt;br&gt;[Slow][Fast]&lt;br&gt;&lt;br&gt;① Ping&lt;br&gt;② Read 11&lt;br&gt;③ Write 64=1&lt;br&gt;④ Write 116&lt;br&gt;⑤ Read 132&lt;br&gt;⑥ Write 64=0&lt;br&gt;&lt;br&gt;Fault menu&lt;br&gt;Electrical profile&lt;br&gt;&lt;br&gt;Motor dial&lt;br&gt;(current / goal)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="51.0" y="159.4" width="148.5" height="426.8" as="geometry"/></mxCell><mxCell id="p925856-9" value="&lt;b&gt;02 Hardware (3D)&lt;/b&gt;   ←/→ to rotate&lt;br&gt;&lt;br&gt;PC — USB — MCU — level shifter — buffer — actuator&lt;br&gt;USB blue · TX orange · RX green · DIR purple · DATA cyan&lt;br&gt;flying squares = bytes in transit&lt;br&gt;&lt;br&gt;bottom badge: DIR HIGH/LOW and gate state" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="207.75" y="159.4" width="415.25000000000006" height="199.10000000000002" as="geometry"/></mxCell><mxCell id="p925856-10" value="&lt;b&gt;Lens (zoom)&lt;/b&gt;  [MCU internals] [Buffer] [Waveform]&lt;br&gt;&lt;br&gt;MCU: UART0/UART1 shift registers, FIFO(16), SRAM g_buf/g_rx, DIR&lt;br&gt;Buffer: TX/RX gates, /OE1 and OE2&lt;br&gt;Waveform: TX, DIR, FIFO_EMPTY, TX_COMPLETE" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="207.75" y="365.1" width="415.25000000000006" height="221.10000000000002" as="geometry"/></mxCell><mxCell id="p925856-11" value="&lt;b&gt;03 Firmware main.c&lt;/b&gt;&lt;br&gt;where: main() → read_packet(...)&lt;br&gt;&lt;br&gt;lines tagged [NN] highlighted yellow&lt;br&gt;auto-scrolls with the step" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="631.25" y="159.4" width="277.75" height="253.00000000000003" as="geometry"/></mxCell><mxCell id="p925856-12" value="&lt;b&gt;Controls &amp; explanation&lt;/b&gt;&lt;br&gt;HEX entry (editable)&lt;br&gt;[Load][Next][Auto play][Replay][Reset]&lt;br&gt;&lt;br&gt;step heading 01/12 …&lt;br&gt;plain-language text + glossary" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=top;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="631.25" y="419.0" width="277.75" height="167.20000000000002" as="geometry"/></mxCell><mxCell id="p925856-13" value="&lt;b&gt;Byte strip&lt;/b&gt;   TX PC→actuator (20 cells) / RX actuator→PC (20 cells)   decode: ID · instr · length · CRC OK / Error" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#223247;strokeColor=#3b5473;fontColor=#d9e6f5;fontSize=11;align=center;verticalAlign=middle;spacingLeft=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="51.0" y="595.0" width="858.0000000000001" height="46.2" as="geometry"/></mxCell><mxCell id="p925856-14" value="&lt;b&gt;Lens tab chosen per step (LENS_FOR_STEP)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="600" height="24" as="geometry"/></mxCell><mxCell id="p925856-15" value="Lens tab" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="200" height="40" as="geometry"/></mxCell><mxCell id="p925856-16" value="Steps" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="400" height="40" as="geometry"/></mxCell><mxCell id="p925856-17" value="MCU internals" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="200" height="40" as="geometry"/></mxCell><mxCell id="p925856-18" value="1, 2, 3, 5, 8, 10, 11, 12" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="160" width="400" height="40" as="geometry"/></mxCell><mxCell id="p925856-19" value="Tri-state buffer" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="200" width="200" height="40" as="geometry"/></mxCell><mxCell id="p925856-20" value="4, 7, 9" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="200" width="400" height="40" as="geometry"/></mxCell><mxCell id="p925856-21" value="Waveform" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="240" width="200" height="40" as="geometry"/></mxCell><mxCell id="p925856-22" value="6" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="240" width="400" height="40" as="geometry"/></mxCell><mxCell id="p925856-23" value="&lt;b&gt;Keyboard &amp; behaviour&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#333333;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="600" height="24" as="geometry"/></mxCell><mxCell id="p925856-24" value="• &lt;b&gt;Space&lt;/b&gt; = next step (next_step)&lt;br&gt;• &lt;b&gt;←/→&lt;/b&gt; = rotate the 3D camera ±8°&lt;br&gt;• &lt;b&gt;Esc&lt;/b&gt; = quit&lt;br&gt;• follows window resizes (resize_ui)&lt;br&gt;• &lt;b&gt;--screenshot&lt;/b&gt; = headless self-test + saves output/*.png&lt;br&gt;• trace export() → output/trace-YYYYMMDD-HHMMSS.json&lt;br&gt;   mode = SIMULATION_ONLY, hardware_tested = false&lt;br&gt;• HEX input limited to 16 bytes (display FIFO depth), instructions 01/02/03 only" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="600" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="12. Runtime state machine &amp; frame loop" id="p47960"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p47960-2" value="&lt;b&gt;12. Runtime: packet state transitions and the tick() frame loop&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1594" height="36" as="geometry"/></mxCell><mxCell id="p47960-3" value="How Demo.finished / running / step_index / seq relate." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1594" height="26" as="geometry"/></mxCell><mxCell id="p47960-4" value="&lt;b&gt;Idle&lt;/b&gt;&lt;br&gt;finished = True" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="240" height="100" as="geometry"/></mxCell><mxCell id="p47960-5" value="&lt;b&gt;Loaded&lt;/b&gt;&lt;br&gt;step_index = −1&lt;br&gt;finished = False" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="p47960-6" value="&lt;b&gt;Stepping&lt;/b&gt;&lt;br&gt;step 1 … 12" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="280" height="100" as="geometry"/></mxCell><mxCell id="p47960-7" value="&lt;b&gt;Finished&lt;/b&gt;&lt;br&gt;after step 12&lt;br&gt;finished = True" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="240" height="100" as="geometry"/></mxCell><mxCell id="p47960-8" value="&lt;b&gt;Stopped (failure)&lt;/b&gt;&lt;br&gt;stop(): finished = True&lt;br&gt;flow_state = fail" style="html=1;whiteSpace=wrap;ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="280" height="100" as="geometry"/></mxCell><mxCell id="p47960-9" value="load_packet() ok&lt;br&gt;(HEX / button)" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-4" target="p47960-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-10" value="Next / Space /&lt;br&gt;Auto play" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-5" target="p47960-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-11" value="step 12 done" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-6" target="p47960-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-12" value="one next_step() call per step&lt;br&gt;(×12)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#555;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="108" width="180" height="36" as="geometry"/></mxCell><mxCell id="p47960-13" value="fault / no reply / electrical risk" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-6" target="p47960-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-14" value="Replay / a new load_packet()" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="p47960-7" target="p47960-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="100"/><mxPoint x="180" y="100"/></Array></mxGeometry></mxCell><mxCell id="p47960-15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="p47960-8" target="p47960-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="390"/></Array></mxGeometry></mxCell><mxCell id="p47960-16" value="&lt;b&gt;load_packet() input checks&lt;/b&gt;&lt;br&gt;from_hex() → parse() (CRC / Length / header) → instruction ∈ {1,2,3} → length ≤ 16&lt;br&gt;On failure shows &quot;input not sent&quot; and leaves state unchanged. On success discards flights, latches active_fault / active_profile, adjusts return_level, resets FW variables and shows the decode line." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="640" height="115" as="geometry"/></mxCell><mxCell id="p47960-17" value="&lt;b&gt;settle()&lt;/b&gt;: before advancing, instantly finishes flights, timers and waveform animation (up to 200 passes)." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d4f1f9;strokeColor=#1a9bb5;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="690" height="70" as="geometry"/></mxCell><mxCell id="p47960-18" value="&lt;b&gt;tick(task) — runs every frame (taskMgr)&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=top;container=1;collapsible=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="1590" height="440" as="geometry"/></mxCell><mxCell id="p47960-19" value="dt = min(frame dt, 0.1)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p47960-20" value="unless active_fault is &quot;unpowered&quot;:&lt;br&gt;motor.update(dt)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p47960-21" value="refresh_motor()&lt;br&gt;dial, 3D horn, text" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p47960-22" value="timers: run due&lt;br&gt;later() callbacks" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p47960-23" value="wave_anim&lt;br&gt;advance waveform cursor" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p47960-24" value="flights&lt;br&gt;Flight.update(now)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="700" width="235" height="70" as="geometry"/></mxCell><mxCell id="p47960-25" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-19" target="p47960-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-26" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-20" target="p47960-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-27" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-21" target="p47960-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-28" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-22" target="p47960-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-29" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-23" target="p47960-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-30" value="busy = flights ∨ timers ∨ wave_anim" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="820" width="270" height="70" as="geometry"/></mxCell><mxCell id="p47960-31" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p47960-24" target="p47960-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-32" value="running ?" style="html=1;whiteSpace=wrap;rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="810" width="250" height="90" as="geometry"/></mxCell><mxCell id="p47960-33" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p47960-30" target="p47960-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-34" value="if busy: step_done_at = 0. Once idle for 1.5 s ÷ speed:&lt;br&gt;&lt;b&gt;next_step()&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="815" width="380" height="80" as="geometry"/></mxCell><mxCell id="p47960-35" value="Yes" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-32" target="p47960-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-36" value="&lt;b&gt;seq&lt;/b&gt; set ∧ finished ∧ not busy ∧ next_at passed&lt;br&gt;→ seq_next() → flow_click_seq()" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="950" width="370" height="100" as="geometry"/></mxCell><mxCell id="p47960-37" value="No" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=2;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p47960-32" target="p47960-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47960-38" value="&lt;b&gt;Speed&lt;/b&gt;  set_speed(1|3)&lt;br&gt;All delays and travel times are divided by speed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Automatic flow (seq)&lt;/b&gt;&lt;br&gt;start_sequence() → ping → mode → on → goal → pos (up to 8 times)&lt;br&gt;packet_result() sets next_at (1.6 s; pos 1.2 s)&lt;br&gt;On failure seq = None and the flow stops." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="420" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>