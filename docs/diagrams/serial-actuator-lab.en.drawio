e=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="296" width="60" height="44" as="geometry"/></mxCell><mxCell id="p20179-36" value="R/W" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="296" width="70" height="44" as="geometry"/></mxCell><mxCell id="p20179-37" value="0 – 4095" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="296" width="190" height="44" as="geometry"/></mxCell><mxCell id="p20179-38" value="≥ 4096 → Error 6. With torque OFF it is stored but nothing moves" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="296" width="380" height="44" as="geometry"/></mxCell><mxCell id="p20179-39" value="2048 (180°)" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="296" width="160" height="44" as="geometry"/></mxCell><mxCell id="p20179-40" value="122" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="70" height="44" as="geometry"/></mxCell><mxCell id="p20179-41" value="Moving" style="rounded=0;spacingLeft=4;spacingRight=4;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="340" width="190" height="44" as="geometry"/></mxCell><mxCell id="p20179-42" value="1" style="rounded=0;spacingLeft=4;sp