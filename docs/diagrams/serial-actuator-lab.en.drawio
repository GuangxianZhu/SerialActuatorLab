ll id="p616362-13" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#999999;strokeWidth=1;fontSize=11;fontColor=#333333;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="156" as="sourcePoint"/><mxPoint x="1350" y="1300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p616362-14" value="&lt;b&gt;Actuator&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1545" y="100" width="170" height="56" as="geometry"/></mxCell><mxCell id="p616362-15" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#999999;strokeWidth=1;fontSize=11;fontColor=#333333;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1630" y="156" as="sourcePoint"/><mxPoint x="1630" y="1300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p616362-16" value="01" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-17" value="PC builds the packet.&lt;br&gt;MCU idles in read_packet(PC_UART)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="130" y="206" width="760" height="60" as="geometry"/></mxCell><mxCell id="p616362-18" value="02" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="312" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-19" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E88E5;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="340" as="sourcePoint"/><mxPoint x="510" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p616362-20" value="bytes sent one by one (USB → HOST_RX) → RX FIFO → UART_READ → g_buf[n]" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="238" y="296" width="264" height="40" as="geometry"/></mxCell><mxCell id="p616362-21" value="03" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="404" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-22" value="at n = 7 compute need = 7 + Length; packet complete when n == need" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="410" y="390" width="480" height="60" as="geometry"/></mxCell><mxCell id="p616362-23" value="04" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="496" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-24" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="524" as="sourcePoint"/><mxPoint x="1350" y="524" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p616362-25" value="gpio_write_dir(1): DIR = 1 → TX gate open, RX gate closed" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="798" y="480" width="544" height="40" as="geometry"/></mxCell><mxCell id="p616362-26" value="05" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="588" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-27" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#E67E00;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="616" as="sourcePoint"/><mxPoint x="1630" y="616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p616362-28" value="UART_WRITE → TX FIFO → shift register → ACT_TX → buffer → DATA (bit by bit)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1078" y="572" width="544" height="40" as="geometry"/></mxCell><mxCell id="p616362-29" value="06" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-30" value="while (!uart_tx_complete) — wait for the last stop bit (FIFO empty is NOT enough)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="690" y="666" width="760" height="60" as="geometry"/></mxCell><mxCell id="p616362-31" value="07" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="772" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-32" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7E57C2;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="800" as="sourcePoint"/><mxPoint x="1350" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p616362-33" value="gpio_write_dir(0): DIR = 0 → TX output Hi-Z, RX gate open" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="798" y="756" width="544" height="40" as="geometry"/></mxCell><mxCell id="p616362-34" value="08" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="864" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-35" value="Actuator checks ID / CRC and executes; MCU waits in read_packet(MOTOR_UART, 20 ms)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="690" y="850" width="1040" height="60" as="geometry"/></mxCell><mxCell id="p616362-36" value="09" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="956" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-37" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1630" y="984" as="sourcePoint"/><mxPoint x="1350" y="984" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p616362-38" value="after ~0.5 ms (Return Delay) the Status packet goes onto DATA → through the RX gate" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1358" y="940" width="264" height="40" as="geometry"/></mxCell><mxCell id="p616362-39" value="10" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1048" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-40" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#2E9E5B;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350" y="1076" as="sourcePoint"/><mxPoint x="790" y="1076" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p616362-41" value="ACT_RX → UART1 shift reg → RX FIFO → UART_READ → g_rx (same read_packet)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="798" y="1032" width="544" height="40" as="geometry"/></mxCell><mxCell id="p616362-42" value="11" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1140" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-43" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1E88E5;strokeWidth=4;fontSize=11;fontColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="1168" as="sourcePoint"/><mxPoint x="230" y="1168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p616362-44" value="pc_write(g_rx, n): forwarded unchanged via UART0 → USB to the PC" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#222222;fontSize=12;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="238" y="1124" width="544" height="40" as="geometry"/></mxCell><mxCell id="p616362-45" value="12" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1232" width="44" height="32" as="geometry"/></mxCell><mxCell id="p616362-46" value="PC checks header / Length / CRC; Instruction = 55, Error = 00. MCU is back at step 1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=15;" vertex="1" parent="1"><mxGeometry x="130" y="1218" width="760" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7. Firmware flowcharts" id="p483301"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p483301-2" value="&lt;b&gt;7. firmware/main.c: main() / read_packet() / motor_send() / pc_write()&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1f3a5f;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1640" height="36" as="geometry"/></mxCell><mxCell id="p483301-3" value="[NN] are the step tags in the code comments. Left: main loop / middle: receive / right: send and forward. A circled &quot;A&quot; jumps back to the top of w